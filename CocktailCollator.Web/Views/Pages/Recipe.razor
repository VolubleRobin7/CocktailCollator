@using CocktailCollator.Application.Common.Authorisation
@using CocktailCollator.Web.FormModels.Recipes
@using CocktailCollator.Web.ViewModels.RecipeCategories
@using CocktailCollator.Web.ViewModels.Recipes
@using CocktailCollator.Web.Views.Components.Buttons
@using CocktailCollator.Web.Views.Components.Helpers
@using CocktailCollator.Web.Views.Components.Inputs
@using CocktailCollator.Web.Views.Modals
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager NavigationManager
@inject RecipeCategoriesViewModel RecipeCategoriesViewModel
@inject UpdateRecipeFormModel UpdateRecipeFormModel
@inject RecipesViewModel ViewModel

@page "/recipe/{RecipeId:guid}"

<PageTitle>@(this._recipe?.Name ?? "Recipe Details")</PageTitle>

<div class="container">
    <div class="mb-4">
        <Button @onclick="this.GoBack" 
                Text="← Back to Recipes" 
                Theme="ButtonTheme.Secondary" />
    </div>

    @if (this._recipe is null)
    {
        if (this._isLoading)
        {
            <p>Loading...</p>
        }
        else
        {
            <p>Recipe not found.</p>
        }
    }
    else
    {
        @* Mobile Title & Metadata *@
        <div class="d-md-none text-center mb-4">
            @if (this._isEditing)
            {
                <div class="text-start">
                    <InputField Input="this.UpdateRecipeFormModel.Name"
                                InvalidMessage="Name requires a value."
                                Title="Recipe Name" />
                </div>
            }
            else
            {
                <h2 class="display-5 fw-semibold mb-2">
                    @this._recipe.Name
                </h2>

            }

            <div class="d-flex justify-content-center gap-3 text-secondary mt-2 small">
                <span>★★★★☆ 4.5</span>
                <span>45 mins</span>
                <span>Serves 4</span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-5 mb-4">
                @if (this._isEditing)
                {
                    <DocumentUpload @ref="this._documentUpload"
                                    Accept="image/*"
                                    Documents="this.UpdateRecipeFormModel.Images"
                                    Multiple
                                    Title="Images"
                                    class="mb-3" />
                }
                else
                {
                    <img alt="@this._recipe.Name"
                         class="w-100 rounded-3 shadow-sm object-fit-cover"
                         src="@(this._recipe.Images is not null && this._recipe.Images.Any() ? this._recipe.Images.First().Url : "/images/placeholder.jpg")" />
                }
            </div>

            <div class="col-md-7 ps-md-4">
                @* Desktop Title & Metadata *@
                <div class="d-none d-md-block mb-4 pb-3 pt-2 text-center">
                    @if (this._isEditing)
                    {
                        <div class="text-start">
                            <InputField Input="this.UpdateRecipeFormModel.Name"
                                        InvalidMessage="Name requires a value."
                                        Title="Recipe Name" />
                        </div>
                    }
                    else
                    {
                        <h2 class="display-4 fw-semibold mb-2">
                            @this._recipe.Name
                        </h2>

                    }

                    <div class="text-primary d-flex justify-content-center gap-4 mt-3">
                        <span>★★★★☆ 4.5</span>
                        <span>45 mins</span>
                        <span>Serves 4</span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-5 mb-4 mb-lg-0 pe-lg-4">
                        <h4 class="mb-3 pb-2 border-bottom">Ingredients</h4>
                        
                        @if (this._isEditing)
                        {
                            <ul class="list-group">
                                @foreach (var ingredient in this.UpdateRecipeFormModel.Ingredients)
                                {
                                    <li class="list-group-item">
                                        <button type="button"
                                                class="btn btn-secondary w-100 d-flex justify-content-between align-items-center text-start py-2 px-3"
                                                @onclick="() => this.OpenEditIngredientModalAsync(ingredient)">

                                            <span class="fw-medium">
                                                @ingredient.Name.Input
                                            </span>

                                            <span class="text-secondary small">
                                                <span>@ingredient.Amount.Input @(ingredient.MeasurementModel?.Name ?? "")</span>
                                            </span>

                                        </button>

                                        <Button @onclick="() => this.UpdateRecipeFormModel.Ingredients.Remove(ingredient)"
                                                Size="ButtonSize.Small"
                                                Text="Remove"
                                                Theme="ButtonTheme.Danger"
                                                class="mt-2" />
                                    </li>
                                }
                            </ul>

                            <Button @onclick="() => this.OpenEditIngredientModalAsync(null)"
                                    Size="ButtonSize.Small"
                                    Text="Add Ingredient"
                                    Theme="ButtonTheme.Primary"
                                    class="mt-3" />
                        }
                        else
                        {
                            <ul class="list-unstyled">
                                @foreach (var ingredient in this._recipe.Ingredients ?? [])
                                {
                                    <li class="mb-2 pb-2 border-bottom border-light d-flex justify-content-between align-items-center">
                                        <span class="fw-medium">
                                            @(ingredient.Ingredient?.Name ?? "")
                                        </span>

                                        <span class="text-secondary small">
                                            @ingredient.Amount @(ingredient.Measurement?.Name ?? "")
                                        </span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                    
                    <div class="col-lg-7">
                        <h4 class="mb-3 pb-2 border-bottom">Instructions</h4>
                        
                        @if (this._isEditing)
                        {
                            <ul class="list-group">
                                @foreach (var step in this.UpdateRecipeFormModel.Steps)
                                {
                                    <li class="d-flex align-items-start list-group-item">
                                        <div class="me-3 mt-1">
                                            <span class="step-number d-flex align-items-center justify-content-center rounded-circle bg-primary text-white">
                                                @(step.Order.Input + 1)
                                            </span>
                                        </div>

                                        <div class="flex-grow-1">
                                            <InputField Input="step.Instruction"
                                                        InvalidMessage="Instruction requires a value." />

                                            <div class="d-flex gap-2 mt-2">
                                                <div class="btn-group">
                                                    <Button @onclick="() => this.MoveStepUp(step)"
                                                            Size="ButtonSize.Small"
                                                            Text="▲"
                                                            Theme="ButtonTheme.Secondary"
                                                            disabled="@(step.Order.Input <= 0)" />

                                                    <Button @onclick="() => this.MoveStepDown(step)"
                                                            Size="ButtonSize.Small"
                                                            Text="▼"
                                                            Theme="ButtonTheme.Secondary"
                                                            disabled="@(step.Order.Input >= this.UpdateRecipeFormModel.Steps.Count - 1)" />
                                                </div>

                                                <Button @onclick="() => this.RemoveStep(step)"
                                                        Size="ButtonSize.Small"
                                                        Text="Remove"
                                                        Theme="ButtonTheme.Danger" />
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ul>

                            <Button @onclick="this.AddStep"
                                    Size="ButtonSize.Small"
                                    Text="Add Step"
                                    Theme="ButtonTheme.Primary"
                                    class="mt-3" />
                        }
                        else
                        {
                            <ol class="list-unstyled">
                                @foreach (var step in this._recipe.Steps?.OrderBy(step => step.Order).ToList() ?? [])
                                {
                                    <li class="mb-4 d-flex">
                                        <div class="me-3 mt-1">
                                            <span class="step-number d-flex align-items-center justify-content-center rounded-circle bg-primary text-white">
                                                @(step.Order + 1)
                                            </span>
                                        </div>

                                        <div>
                                            <p class="mb-0">
                                                @step.Instruction
                                            </p>
                                        </div>
                                    </li>
                                }
                            </ol>
                        }
                    </div>
                </div>

                <div class="mt-4 pt-3">
                    <h4 class="mb-3 pb-2 border-bottom">Recipe Notes</h4>

                    @if (this._isEditing)
                    {
                        <div class="mb-3">
                            <textarea @bind="this.UpdateRecipeFormModel.Note.Input"
                                      class="form-control"
                                      placeholder="Add recipe notes..."
                                      rows="5"></textarea>
                        </div>
                    }
                    else
                    {
                        @if (!string.IsNullOrWhiteSpace(this._recipe.Note))
                        {
                            <p class="mb-0 note-text">@this._recipe.Note</p>
                        }
                        else
                        {
                            <p class="mb-0 text-secondary fst-italic">No recipe notes.</p>
                        }
                    }
                </div>

                <AuthorizeView Context="authContext">
                    <Authorized>
                        <div class="mt-4 pt-3 border-top">
                            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                                <h4 class="mb-0">Personal Notes</h4>
                                <AuthorizeView Context="manageRecipesContext" Policy="@Policies.ManageRecipes">
                                    <NotAuthorized>
                                        @if (!this._isEditingPersonalNote)
                                        {
                                            <Button @onclick="this.EnterPersonalNoteEditMode"
                                                    Size="ButtonSize.Small"
                                                    Text="Edit"
                                                    Theme="ButtonTheme.Secondary" />
                                        }
                                    </NotAuthorized>
                                </AuthorizeView>
                            </div>

                            @if (this._isEditing || this._isEditingPersonalNote)
                            {
                                <div class="mb-3">
                                    <textarea @bind="this.UpdateRecipeFormModel.PersonalNote.Input"
                                              class="form-control"
                                              placeholder="Add a personal note..."
                                              rows="5"></textarea>
                                </div>

                                @if (this._isEditingPersonalNote && !this._isEditing)
                                {
                                    <div class="d-flex gap-2">
                                        <Button @onclick="this.SavePersonalNoteAsync"
                                                Size="ButtonSize.Small"
                                                Text="Save"
                                                Theme="ButtonTheme.Success" />

                                        <Button @onclick="this.CancelPersonalNoteEdit"
                                                Size="ButtonSize.Small"
                                                Text="Cancel"
                                                Theme="ButtonTheme.Secondary" />
                                    </div>
                                }
                            }
                            else
                            {
                                @if (!string.IsNullOrWhiteSpace(this._recipe.PersonalNote))
                                {
                                    <p class="mb-0 note-text">@this._recipe.PersonalNote</p>
                                }
                                else
                                {
                                    <p class="mb-0 text-secondary fst-italic">No personal notes.</p>
                                }
                            }
                        </div>
                    </Authorized>
                </AuthorizeView>

                @* im not entirely sure where to put this *@
                @if (this._isEditing)
                {
                    <label class="form-label mt-3">Category</label>
                    <div class="input-group flex-nowrap">
                        <input class="form-control flex-grow-1"
                                disabled
                                placeholder="Select a category..."
                                type="text"
                                value="@(this.UpdateRecipeFormModel.RecipeCategory.Input?.Name ?? "")" />

                        <Button @onclick="() => this.UpdateRecipeFormModel.RecipeCategory.Input = null"
                                Text="Clear"
                                Theme="ButtonTheme.Danger" />
                                
                        <button aria-expanded="false"
                                class="btn btn-outline-secondary dropdown-toggle dropdown-toggle-split flex-shrink-0"
                                data-bs-toggle="dropdown"
                                type="button">
                            <span class="visually-hidden">Toggle Dropdown</span>
                        </button>

                        <ul class="dropdown-menu">
                            <li>
                                <input @bind-value:event="oninput"
                                        @bind-value:get="this._categorySearchString"
                                        @bind-value:set="this.SetCategorySearchValue"
                                        class="form-control mb-2"
                                        placeholder="Type to search..."
                                        type="text" />
                            </li>

                            @foreach (var category in this._categorySearchResults)
                            {
                                <li>
                                    <span @onclick="() => this.UpdateRecipeFormModel.RecipeCategory.Input = category"
                                            class="dropdown-item cursor-pointer">@category.Name</span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>

        <div class="mt-5 py-3 border-top d-flex justify-content-between align-items-center">
            <AuthorizeView Policy="@Policies.ManageRecipes">
                @if (this._isEditing)
                {
                    <div class="d-flex gap-2">
                        <FormChangeWrapper FormModel="this.UpdateRecipeFormModel">
                            <Button @onclick="this.SaveRecipeAsync"
                                    Text="Save Recipe"
                                    Theme="ButtonTheme.Success"
                                    disabled="@(!this.UpdateRecipeFormModel.IsValid())" />
                        </FormChangeWrapper>

                        <Button @onclick="this.CancelEditing"
                                Text="Cancel"
                                Theme="ButtonTheme.Secondary" />
                    </div>
                }
                else
                {
                    <Button @onclick="this.StartEditing"
                            Text="Edit"
                            Theme="ButtonTheme.Secondary" />

                    <Button @onclick="this.DeleteRecipe"
                            Text="Delete Recipe"
                            Theme="ButtonTheme.Danger" />
                }
            </AuthorizeView>
        </div>
    }
</div>

<ConfigureRecipeIngredientModal @ref="this._ingredientModal"
                                OnIngredientUpdated="this.UpdateIngredient" />

@code {
    private List<RecipeCategoryViewModel> _categorySearchResults = [];
    private string _categorySearchString = "";
    private DocumentUpload? _documentUpload;
    private ConfigureRecipeIngredientModal _ingredientModal = default!;
    private bool _isLoading = true;
    private bool _isEditing = false;
    private bool _isEditingPersonalNote = false;
    private RecipeViewModel? _recipe;

    [Parameter]
    public Guid RecipeId { get; set; }

    [SupplyParameterFromQuery(Name = "edit")]
    public bool StartInEditMode { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!this.ViewModel.Recipes.Any())
            await this.ViewModel.GetCommand.ExecuteAsync(null);

        this._recipe = this.ViewModel.Recipes.FirstOrDefault(r => r.RecipeId == this.RecipeId);
        this._isLoading = false;

        if (this.StartInEditMode)
            await this.StartEditing();
    }

    private void AddStep()
    {
        var step = new RecipeFormModelStep();
        step.Order.Input = this.UpdateRecipeFormModel.Steps.Count;
        this.UpdateRecipeFormModel.Steps.Add(step);
    }

    private void CancelEditing()
    {
        this._documentUpload?.Reset();
        this.UpdateRecipeFormModel.ResetToDefault();
        this._isEditing = false;
        this._isEditingPersonalNote = false;
        this.NavigationManager.NavigateTo($"/recipe/{this.RecipeId}", replace: true);
        this.StateHasChanged();
    }

    private void CancelPersonalNoteEdit()
    {
        this.UpdateRecipeFormModel.ResetToDefault();
        this._isEditingPersonalNote = false;
    }

    private async Task DeleteRecipe()
    {
        await this.ViewModel.DeleteCommand.ExecuteAsync(this.RecipeId);
        this.NavigationManager.NavigateTo("/");
    }

    private void EnterPersonalNoteEditMode()
    {
        if (this._recipe is null)
            return;

        this.UpdateRecipeFormModel.PopulateFrom(this._recipe);
        this._isEditingPersonalNote = true;
    }

    private void GoBack()
        => this.NavigationManager.NavigateTo("/");

    private void MoveStepDown(RecipeFormModelStep step)
    {
        if (step.Order.Input >= this.UpdateRecipeFormModel.Steps.Count - 1)
            return;

        this.UpdateRecipeFormModel.Steps.Move(step, 1);
        this.RecalculateSteps();
    }

    private void MoveStepUp(RecipeFormModelStep step)
    {
        if (step.Order.Input <= 0)
            return;

        this.UpdateRecipeFormModel.Steps.Move(step, -1);
        this.RecalculateSteps();
    }

    private void RecalculateSteps()
    {
        for (int i = 0; i < this.UpdateRecipeFormModel.Steps.Count; i++)
            this.UpdateRecipeFormModel.Steps[i].Order.Input = i;
    }

    private void RemoveStep(RecipeFormModelStep stepIndex)
    {
        _ = this.UpdateRecipeFormModel.Steps.Remove(stepIndex);
        this.RecalculateSteps();
    }

    private async Task SavePersonalNoteAsync()
    {
        if (this._recipe is null)
            return;

        await this.ViewModel.UpdateCommand.ExecuteAsync(this.UpdateRecipeFormModel.ExtractToInputPort());

        this.UpdateRecipeFormModel.ResetToDefault();
        this._isEditingPersonalNote = false;
        this._recipe = this.ViewModel.Recipes.FirstOrDefault(r => r.RecipeId == this.RecipeId);
        this.StateHasChanged();
    }

    private async Task SaveRecipeAsync()
    {
        if (this._recipe is null || !this.UpdateRecipeFormModel.IsValid())
            return;

        await this.ViewModel.UpdateCommand.ExecuteAsync(this.UpdateRecipeFormModel.ExtractToInputPort());

        this._documentUpload?.Reset();
        this.UpdateRecipeFormModel.ResetToDefault();
        this._isEditing = false;
        this._isEditingPersonalNote = false;
        this.NavigationManager.NavigateTo($"/recipe/{this.RecipeId}", replace: true);
        this.StateHasChanged();
    }

    private void SetCategorySearchValue(string? value)
    {
        this._categorySearchString = value ?? "";
        this._categorySearchResults = this.RecipeCategoriesViewModel.RecipeCategories
            .Where(category => category.Name is not null && category.Name.Contains(this._categorySearchString, StringComparison.OrdinalIgnoreCase))
            .Take(5)
            .ToList();
    }

    private async Task StartEditing()
    {
        if (this._recipe is null)
            return;

        var _AuthState = await this.AuthenticationStateProvider.GetAuthenticationStateAsync();
        var _AuthResult = await this.AuthorizationService.AuthorizeAsync(_AuthState.User, Policies.ManageRecipes);
        if (!_AuthResult.Succeeded)
            return;

        this.UpdateRecipeFormModel.PopulateFrom(this._recipe);
        await this.RecipeCategoriesViewModel.GetCommand.ExecuteAsync(default);
        this.SetCategorySearchValue("");
        this._isEditingPersonalNote = false;
        this._isEditing = true;
        this.NavigationManager.NavigateTo($"/recipe/{this.RecipeId}?edit=true", replace: true);
    }

    private async Task OpenEditIngredientModalAsync(RecipeFormModelIngredient? ingredient)
        => await this._ingredientModal.OpenModalAsync(ingredient);

    private void UpdateIngredient(RecipeFormModelIngredient ingredient)
    {
        var existingIndex = this.UpdateRecipeFormModel.Ingredients.IndexOf(ingredient);
        if (existingIndex >= 0)
        {
            this.UpdateRecipeFormModel.Ingredients[existingIndex] = ingredient;
        }
        else
        {
            this.UpdateRecipeFormModel.Ingredients.Add(ingredient);
        }

        this.StateHasChanged();
    }
}
