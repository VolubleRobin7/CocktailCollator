@using CocktailCollator.Web.ViewModels.Measurements
@using CocktailCollator.Web.Views.Components.Buttons
@using CocktailCollator.Web.Views.Components.Navbars

@inject MeasurementsViewModel ViewModel

@page "/measurements"

<PageTitle>Measurements</PageTitle>

<Navbar CurrentPage="measurements" />

<div class="container pt-2">

    <Button @onclick="this.ViewModel.GetCommand.ExecuteAsync"
            Theme="ButtonTheme.Secondary"
            Text="Get Measurements" />

    <ul class="list-group list-group-flush">
        @foreach (var measurement in this.ViewModel.Measurements)
        {
            <li class="list-group-item">
                <div class="d-flex justify-content-between">
                    <span class="align-content-center">
                        @measurement.Name
                    </span>
                    <Button @onclick="() => this.ViewModel.DeleteCommand.ExecuteAsync(measurement.MeasurementId)"
                            Size="ButtonSize.Small"
                            Theme="ButtonTheme.Danger"
                            Text="Remove" />
                </div>
            </li>
        }
    </ul>

</div>

<p>@this.ViewModel.Error</p>

