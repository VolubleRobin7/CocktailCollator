@using CocktailCollator.Web.ViewModels.Measurements
@using CocktailCollator.Web.Views.Components.Buttons
@using CocktailCollator.Web.Views.Modals

@inject MeasurementsViewModel ViewModel

@attribute [Authorize(Policy = Policies.ViewMeasurements)]

@page "/measurements"

<PageTitle>Measurements</PageTitle>

<div class="container">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <h4 class="m-0">Measurements</h4>

        <div class="d-grid d-md-flex gap-2">
            <Button @onclick="this.ViewModel.GetCommand.ExecuteAsync"
                    Text="Get Measurements"
                    Theme="ButtonTheme.Primary" />

            <AuthorizeView Policy="@Policies.ManageMeasurements">
                <Button @onclick="() => this._createModal.OpenModalAsync()"
                        Text="Create Measurement"
                        Theme="ButtonTheme.Secondary" />
            </AuthorizeView>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="border-bottom border-primary">
                    <tr>
                        <th class="border-0 px-4 py-3">Name</th>
                        <th class="border-0 px-4 py-3">Abbreviation</th>
                        <th class="border-0 px-4 py-3 text-end"></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var measurement in this.ViewModel.Measurements)
                    {
                        <tr>
                            <td class="px-4 py-3">Constant Name</td>
                            <td class="px-4 py-3">@measurement.Name</td>

                            <td class="px-4 py-3 text-end">
                                <AuthorizeView Policy="@Policies.ManageMeasurements">
                                    <span @onclick="() => this.ViewModel.DeleteCommand.ExecuteAsync(measurement.MeasurementId)"
                                          class="text-danger opacity-50 cursor-pointer user-select-none hover-opacity-100 fs-5 lh-1" 
                                          title="Remove">
                                        &times;
                                    </span>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<CreateMeasurementModal @ref="this._createModal"
                        OnAfterCreation="this.StateHasChanged" />

@code {
    private CreateMeasurementModal _createModal = default!;
}
