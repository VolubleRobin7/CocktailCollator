@using CocktailCollator.Application.UseCases.Recipes.CreateRecipe
@using CocktailCollator.Web.ViewModels
@using CocktailCollator.Web.ViewModels.Recipes

@inject RecipesViewModel ViewModel

@page "/"

<PageTitle>Home</PageTitle>

<h2>Create Recipe</h2>

<div>

    <div>
        <label>Recipe Name:</label>
        <input @bind="_createRecipeInputPort.Name" />
    </div>

    <h4>Ingredients</h4>

    @foreach (var ingredient in _createRecipeInputPort.Ingredients)
    {
        <div>
            <label>Name:</label>
            <input @bind="ingredient.Name" />

            <button @onclick="() => _createRecipeInputPort.Ingredients.Remove(ingredient)">Remove</button>
        </div>
    }

    <button @onclick="() => _createRecipeInputPort.Ingredients.Add(new() { Name = string.Empty })">Add Ingredient</button>

    <h4>Steps</h4>

    @foreach (var steps in _createRecipeInputPort.Steps)
    {
        <div>
            <label>Name:</label>
            <input @bind="steps.Instruction" />

            <button @onclick="() => _createRecipeInputPort.Steps.Remove(steps)">Remove</button>
        </div>
    }

    <button @onclick="() => _createRecipeInputPort.Steps.Add(new() { Instruction = string.Empty, Order = 0 })">Add Step</button>

    <br />

    <button @onclick="() => this.ViewModel.CreateCommand.ExecuteAsync(this._createRecipeInputPort)">Save Recipe</button>
</div>

<hr />

<h2>Get Recipes</h2>

<button @onclick="this.ViewModel.GetCommand.ExecuteAsync">Get recipes</button>

<table>
    <thead>
        <tr>
            <th>Recipe ID</th>
            <th>Recipe Name</th>
            <th>Ingredients</th>
            <th>Steps</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var recipe in ViewModel.Recipes)
        {
            <tr>
                <td>@recipe.RecipeId</td>
                <td>@recipe.Name</td>
                <td>
                    <table>
                        <thead>
                            <tr>
                                <th>Ingredient ID</th>
                                <th>Ingredient Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ingredient in recipe.Ingredients ?? [])
                            {
                                <tr>
                                    <td>@ingredient.IngredientId</td>
                                    <td>@ingredient.Name</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </td>
                <td>
                    <table>
                        <thead>
                            <tr>
                                <th>Step ID</th>
                                <th>Step Instruction</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var steps in recipe.Steps ?? [])
                            {
                                <tr>
                                    <td>@steps.RecipeStepId</td>
                                    <td>@steps.Instruction</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </td>
                <td>
                    <button @onclick="() => this.ViewModel.DeleteCommand.ExecuteAsync(recipe.RecipeId)">Remove</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<hr />

<h2>Get Ingredients</h2>

<button @onclick="this.ViewModel.GetIngredientsCommand.ExecuteAsync">Get ingredients</button>

<table>
    <thead>
        <tr>
            <th>Ingredient ID</th>
            <th>Ingredient Name</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ingredient in ViewModel.Ingredients)
        {
            <tr>
                <td>@ingredient.IngredientId</td>
                <td>@ingredient.Name</td>
                <td>
                    <button @onclick="() => this.ViewModel.DeleteIngredientCommand.ExecuteAsync(ingredient.IngredientId)">Remove</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<hr />

<p>@ViewModel.Error</p>

@code {
    private CreateRecipeInputPort _createRecipeInputPort = new() { Name = "Example Name" };
}
