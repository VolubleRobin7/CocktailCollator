@using CocktailCollator.Web.FormModels.Recipes
@using CocktailCollator.Web.ViewModels.RecipeCategories
@using CocktailCollator.Web.ViewModels.Recipes
@using CocktailCollator.Web.Views.Components.Buttons
@using CocktailCollator.Web.Views.Components.Modals
@using CocktailCollator.Web.Views.Modals

@inject CreateRecipeFormModel CreateRecipeFormModel
@inject RecipeCategoriesViewModel RecipeCategoriesViewModel
@inject RecipesViewModel ViewModel

@page "/"

<PageTitle>Home</PageTitle>

<div class="container pt-4">
    <div class="row">

        <!-- Left Pane: Recipes Menu -->
        <div class="col-md-8 pe-md-5">
            @if (this.ViewModel.Recipes.Any())
            {
                var groupedRecipes = this.ViewModel.Recipes.GroupBy(r => r.Category?.Name ?? "Uncategorized");
                foreach (var group in groupedRecipes)
                {
                    <h2 class="fs-2 mt-4 mb-4 border-bottom pb-2">@group.Key</h2>
                    
                    @foreach (var recipe in group)
                    {
                        <div class="d-flex align-items-center mb-4">
                            <img alt="@recipe.Name"
                                 class="recipe-thumb object-fit-cover me-3 shadow-sm"
                                 src="/images/placeholder.jpg" />

                            <div class="flex-grow-1 d-flex flex-column">
                                <a @onclick="() => this._selectedRecipe = recipe"
                                   class="recipe-link-wrapper text-decoration-none text-reset d-block"
                                   data-bs-target="@this.RecipeModalId"
                                   data-bs-toggle="modal">

                                    <div class="d-flex align-items-baseline w-100">
                                        <h3 class="serif-heading fs-5 fw-semibold m-0 text-nowrap">@recipe.Name</h3>
                                        <div class="recipe-leader flex-grow-1 mx-2 position-relative"></div>
                                        <div class="fs-6 fw-medium text-secondary text-nowrap">45 mins</div>
                                    </div>

                                    <div class="text-primary small mt-1 d-flex gap-3">
                                        <span>★★★★☆ 4.5</span>
                                        <span>Serves 4</span>
                                    </div>

                                </a>
                                
                                <AuthorizeView Policy="@Policies.ManageRecipes">
                                    <div class="mt-2">
                                        <Button @onclick="() => this.OpenUpdateRecipeModal(recipe)"
                                                Size="ButtonSize.Small"
                                                Text="Edit"
                                                Theme="ButtonTheme.Secondary" />
                                    </div>
                                </AuthorizeView>
                            </div>
                        </div>
                    }
                }
            }
            else
            {
                <p>No recipes available. Click 'Get Recipes' to load.</p>
            }
            
            <p class="text-danger">@this.ViewModel.Error</p>
        </div>

        <!-- Right Pane: Filters & Management -->
        <div class="col-md-4 border-start ps-md-4">
            <h4 class="serif-heading mb-4">Management</h4>
            
            <div class="d-grid gap-2 mb-4">
                <Button @onclick="this.ViewModel.GetCommand.ExecuteAsync"
                        Text="Get Recipes"
                        Theme="ButtonTheme.Primary" />

                <AuthorizeView Policy="@Policies.ManageRecipes">
                    <Button @onclick="() => this._createRecipeModal.OpenModalAsync()"
                            Text="Create Recipe"
                            Theme="ButtonTheme.Secondary" />
                </AuthorizeView>
            </div>

            <hr class="my-4" />

            <h5 class="serif-heading mb-3">Categories</h5>
            
            <div class="d-grid gap-2 mb-3">
                <Button @onclick="this.RecipeCategoriesViewModel.GetCommand.ExecuteAsync"
                        Text="Get Categories"
                        Theme="ButtonTheme.Primary" />

                <AuthorizeView Policy="@Policies.ManageRecipes">
                    <Button @onclick="() => this._createRecipeCategoryModal.OpenModalAsync()"
                            Text="Create Category"
                            Theme="ButtonTheme.Secondary" />
                </AuthorizeView>
            </div>

            <div class="list-group list-group-flush mb-3">
                @foreach (var category in this.RecipeCategoriesViewModel.RecipeCategories)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@category.Name</span>
                        <AuthorizeView Policy="@Policies.ManageRecipes">
                            <Button @onclick="() => this.RecipeCategoriesViewModel.DeleteCommand.ExecuteAsync(category.RecipeCategoryId)"
                                    Size="ButtonSize.Small"
                                    Text="Delete"
                                    Theme="ButtonTheme.Danger" />
                        </AuthorizeView>
                    </div>
                }
            </div>
            
            <p class="text-danger">@this.RecipeCategoriesViewModel.Error</p>
        </div>

    </div>
</div>

<Modal @ref=this._recipeModal
       Size="ModalSize.ExtraLarge"
       Title="@(this._selectedRecipe?.Name ?? "Loading...")">

    <Body>
        @if (this._selectedRecipe is not null)
        {
            @* Mobile Title & Metadata *@
            <div class="d-md-none text-center mb-4">
                <h2 class="serif-heading display-5 fw-semibold mb-2">
                    @this._selectedRecipe.Name
                </h2>

                <div class="d-flex justify-content-center gap-3 text-secondary mt-2 small">
                    <span>★★★★☆ 4.5</span>
                    <span>45 mins</span>
                    <span>Serves 4</span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-5 mb-4">
                    <img alt="@this._selectedRecipe.Name"
                         class="w-100 rounded-3 shadow-sm object-fit-cover"
                         src="/images/placeholder.jpg" />
                </div>

                <div class="col-md-7 ps-md-4">
                    @* Desktop Title & Metadata *@
                    <div class="d-none d-md-block mb-4 pb-3 border-bottom">
                        <h2 class="serif-heading display-4 fw-semibold mb-2">
                            @this._selectedRecipe.Name
                        </h2>

                        <div class="text-primary d-flex gap-4 mt-3">
                            <span>★★★★☆ 4.5</span>
                            <span>45 mins</span>
                            <span>Serves 4</span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-5 mb-4 mb-lg-0 pe-lg-4">
                            <h4 class="serif-heading mb-3 pb-2 border-bottom">Ingredients</h4>
                            
                            <ul class="list-unstyled">
                                @foreach (var ingredient in this._selectedRecipe.Ingredients ?? [])
                                {
                                    <li class="mb-2 pb-2 border-bottom border-light d-flex justify-content-between align-items-center">
                                        <span class="fw-medium text-dark">
                                            @ingredient.Ingredient.Name
                                        </span>

                                        <span class="text-secondary small">
                                            @ingredient.Amount @ingredient.Measurement.Name
                                        </span>
                                    </li>
                                }
                            </ul>
                        </div>
                        
                        <div class="col-lg-7">
                            <h4 class="serif-heading mb-3 pb-2 border-bottom">Instructions</h4>
                            
                            <ol class="list-unstyled">
                                @foreach (var step in this._selectedRecipe.Steps?.OrderBy(step => step.Order).ToList() ?? [])
                                {
                                    <li class="mb-4 d-flex">
                                        <div class="me-3 mt-1">
                                            <span class="step-number d-flex align-items-center justify-content-center rounded-circle bg-primary text-white">
                                                @(step.Order + 1)
                                            </span>
                                        </div>

                                        <div>
                                            <p class="mb-0 text-dark">
                                                @step.Instruction
                                            </p>
                                        </div>
                                    </li>
                                }
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        }
    </Body>

    <Footer>
        <AuthorizeView Policy="@Policies.ManageRecipes">
            <Button @onclick="() => this.ViewModel.DeleteCommand.ExecuteAsync(this._selectedRecipe!.RecipeId)"
                    Text="Delete"
                    Theme="ButtonTheme.Danger"
                    data-bs-dismiss="modal" />
        </AuthorizeView>
    </Footer>

</Modal>

<CreateRecipeModal @ref="this._createRecipeModal"
                   OnAfterCreation="this.StateHasChanged" />

<UpdateRecipeModal @ref="this._updateRecipeModal"
                   OnAfterUpdate="this.StateHasChanged" />

<CreateRecipeCategoryModal @ref="this._createRecipeCategoryModal"
                           OnAfterCreation="this.StateHasChanged" />

@code {
    private CreateRecipeCategoryModal _createRecipeCategoryModal = default!;
    private CreateRecipeModal _createRecipeModal = default!;
    private Modal _recipeModal = default!;
    private RecipeViewModel? _selectedRecipe;
    private UpdateRecipeModal _updateRecipeModal = default!;

    private string RecipeModalId
    {
        get => this._recipeModal?.Id ?? "";
    }

    private async Task OpenUpdateRecipeModal(RecipeViewModel recipe)
    {
        await this._updateRecipeModal.OpenModalAsync(recipe);
    }
}
