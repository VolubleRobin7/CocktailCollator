@using CocktailCollator.Web.FormModels.Recipes
@using CocktailCollator.Web.ViewModels.Recipes

@inject CreateRecipeFormModel CreateRecipeFormModel
@inject RecipesViewModel ViewModel

@page "/"

<PageTitle>Home</PageTitle>

<div class="container">

    <h1>Cocktail Collator</h1>

    <hr />

    <button @onclick="this.ViewModel.GetCommand.ExecuteAsync"
            class="btn btn-secondary">
        Get Recipes
    </button>

    <div class="row">
        @foreach (var recipe in this.ViewModel.Recipes)
        {
            <div class="col-md-4 py-2">
                <div class="card">
                    <h4 class="card-header">@recipe.Name</h4>
                    <div class="card-body">
                        <div class="card-text">
                            A sentence or two describing the content of the card.
                            This can be interesting or not, i dont know.
                        </div>
                        <ul class="list-group list-group-flush">
                            @foreach (var ingredient in recipe.Ingredients?.Take(3) ?? [])
                            {
                                <li class="list-group-item">@ingredient.Name</li>
                            }
                        </ul>
                        <button @onclick="() => this._selectedRecipe = recipe"
                                class="btn btn-sm btn-primary">
                            Select
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

</div>

<hr />

<div class="container">

    @if (_selectedRecipe is not null)
    {
        <h2>@_selectedRecipe.Name</h2>

        <h4>Ingredients</h4>

        <ul class="list-group">
            @foreach (var ingredient in _selectedRecipe.Ingredients ?? [])
            {
                <li class="list-group-item">@ingredient.Name</li>
            }
        </ul>

        <h4>Steps</h4>

        <ul class="list-group">
            @foreach (var step in _selectedRecipe.Steps ?? [])
            {
                <li class="list-group-item">@step.Instruction</li>
            }
        </ul>
    }

</div>

<hr />

<div class="container">

    <button @onclick="this.ViewModel.GetIngredientsCommand.ExecuteAsync"
            class="btn btn-secondary">
        Get Ingredients
    </button>

    <ul class="list-group list-group-flush">
        @foreach (var ingredient in this.ViewModel.Ingredients)
        {
            <li class="list-group-item">
                <div class="d-flex justify-content-between">
                    <span class="align-content-center">
                        @ingredient.Name
                    </span>
                    <button @onclick="() => this.ViewModel.DeleteIngredientCommand.ExecuteAsync(ingredient.IngredientId)"
                            class="btn btn-sm btn-danger">
                        Remove
                    </button>
                </div>
            </li>
        }
    </ul>

</div>

<p>@this.ViewModel.Error</p>

<hr />

<div class="container">
    <form>
        <h3>New Recipe</h3>

        <div>
            <label class="form-label">Recipe Name</label>
            <input @bind-value="this.CreateRecipeFormModel.Name.Input"
                   class="form-control @(this.CreateRecipeFormModel.Name.IsValid() ? "is-valid" : "is-invalid")"
                   type="text" />
            <div class="invalid-feedback">
                Name requires a value.
            </div>
        </div>

        <h4>Ingredients</h4>

        <button @onclick="() => this.CreateRecipeFormModel.Ingredients.Input.Add(new())"
                class="btn btn-primary"
                type="button">
            Add Ingredient
        </button>

        <div>
            <ul class="list-group">
                @foreach (var ingredient in this.CreateRecipeFormModel.Ingredients.Input)
                {
                    <li class="list-group-item">
                        <div>
                            <label class="form-label">Ingredient Name</label>
                            <input @bind-value="ingredient.Name.Input"
                                   class="form-control @(ingredient.Name.IsValid() ? "is-valid" : "is-invalid")"
                                   type="text" />
                            <div class="invalid-feedback">
                                Name requires a value.
                            </div>
                        </div>
                        <button @onclick="() => this.CreateRecipeFormModel.Ingredients.Input.Remove(ingredient)"
                                class="btn btn-sm btn-danger"
                                type="button">
                            Remove
                        </button>
                    </li>
                }
            </ul>
        </div>

        <h4>Steps</h4>

        <button @onclick="() => this.CreateRecipeFormModel.Steps.Input.Add(new())"
                class="btn btn-primary"
                type="button">
            Add Step
        </button>

        <div>
            <ul class="list-group">
                @foreach (var step in this.CreateRecipeFormModel.Steps.Input)
                {
                    <li class="list-group-item">
                        <div>
                            <label class="form-label">Step Instruction</label>
                            <input @bind-value="step.Instruction.Input"
                                   class="form-control @(step.Instruction.IsValid() ? "is-valid" : "is-invalid")"
                                   type="text" />
                            <div class="invalid-feedback">
                                Instruction requires a value.
                            </div>
                        </div>
                        <button @onclick="() => this.CreateRecipeFormModel.Steps.Input.Remove(step)"
                                class="btn btn-sm btn-danger"
                                type="button">
                            Remove
                        </button>
                    </li>
                }
            </ul>
        </div>

        <button @onclick="this.OnClickCreate"
                class="btn btn-success mt-2"
                disabled="@(!this.CreateRecipeFormModel.IsValid())"
                type="button">
            Save Recipe
        </button>
    </form>
</div>

@code {
    private RecipeViewModel? _selectedRecipe;

    private async Task OnClickCreate()
    {
        await this.ViewModel.CreateCommand.ExecuteAsync(this.CreateRecipeFormModel.ExtractToInputPort());
        this.CreateRecipeFormModel.ResetToDefault();
        this.StateHasChanged();
    }
}
