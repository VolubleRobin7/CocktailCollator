@using CocktailCollator.Web.FormModels.Recipes
@using CocktailCollator.Web.ViewModels.Recipes
@using CocktailCollator.Web.Views.Components.Buttons
@using CocktailCollator.Web.Views.Components.Inputs
@using CocktailCollator.Web.Views.Components.Modals
@using CocktailCollator.Web.Views.Modals

@inject CreateRecipeFormModel CreateRecipeFormModel
@inject RecipesViewModel ViewModel

@page "/"

<PageTitle>Home</PageTitle>

<div class="container">

    <h1>Cocktail Collator</h1>

    <hr />

    <Button @onclick="this.ViewModel.GetCommand.ExecuteAsync"
            Theme="ButtonTheme.Secondary"
            Text="Get Recipes" />

    <Button Theme="ButtonTheme.Secondary"
            Text="Create Recipe"
            data-bs-target="@this.CreateRecipeModalId"
            data-bs-toggle="modal" />

    <div class="row">
        @foreach (var recipe in this.ViewModel.Recipes)
        {
            <div class="col-md-4 py-2">
                <div class="card">
                    <h4 class="card-header">@recipe.Name</h4>
                    <div class="card-body">
                        <div class="card-text">
                            A sentence or two describing the content of the card.
                            This can be interesting or not, i dont know.
                        </div>
                        <ul class="list-group list-group-flush">
                            @foreach (var ingredient in recipe.Ingredients?.Take(3) ?? [])
                            {
                                <li class="list-group-item">@ingredient.Name</li>
                            }
                        </ul>
                        <Button @onclick="() => this._selectedRecipe = recipe"
                                Size="ButtonSize.Small"
                                Theme="ButtonTheme.Primary"
                                Text="Select"
                                data-bs-target="@this._recipeModal.Id"
                                data-bs-toggle="modal" />
                    </div>
                </div>
            </div>
        }
    </div>

</div>

<hr />

<div class="container">

    <Button @onclick="this.ViewModel.GetIngredientsCommand.ExecuteAsync"
            Theme="ButtonTheme.Secondary"
            Text="Get Ingredients" />

    <ul class="list-group list-group-flush">
        @foreach (var ingredient in this.ViewModel.Ingredients)
        {
            <li class="list-group-item">
                <div class="d-flex justify-content-between">
                    <span class="align-content-center">
                        @ingredient.Name
                    </span>
                    <Button @onclick="() => this.ViewModel.DeleteIngredientCommand.ExecuteAsync(ingredient.IngredientId)"
                            Size="ButtonSize.Small"
                            Theme="ButtonTheme.Danger"
                            Text="Remove" />
                </div>
            </li>
        }
    </ul>

</div>

<p>@this.ViewModel.Error</p>

<Modal @ref=this._recipeModal
       Size="ModalSize.Large"
       Title="@(this._selectedRecipe?.Name ?? "Loading...")">

    <Body>
        @if (this._selectedRecipe is not null)
        {
            <h4>Ingredients</h4>

            <ul class="list-group">
                @foreach (var ingredient in _selectedRecipe.Ingredients ?? [])
                {
                    <li class="list-group-item">@ingredient.Name</li>
                }
            </ul>

            <h4>Steps</h4>

            <ol class="list-group list-group-flush list-group-numbered">
                @foreach (var step in _selectedRecipe.Steps ?? [])
                {
                    <li class="list-group-item">@step.Instruction</li>
                }
            </ol>
        }
    </Body>

</Modal>

<CreateRecipeModal @ref="this._createRecipeModal"
                   OnAfterCreation="this.StateHasChanged" />

@code {
    private CreateRecipeModal _createRecipeModal = default!;
    private Modal _recipeModal = default!;
    private RecipeViewModel? _selectedRecipe;

    private string CreateRecipeModalId
    {
        get => this._createRecipeModal?.Modal.Id ?? "";
    }
}
