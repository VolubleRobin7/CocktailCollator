@using CocktailCollator.Web.ViewModels
@using CocktailCollator.Web.ViewModels.Recipes

@inject RecipesViewModel ViewModel

@page "/"

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

<button @onclick="this.ViewModel.CreateCommand.ExecuteAsync">Create test recipe</button>

<button @onclick="this.ViewModel.GetCommand.ExecuteAsync">Get recipes</button>

<table>
    <thead>
        <tr>
            <th>Recipe ID</th>
            <th>Recipe Name</th>
            <th>Ingredients</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var recipe in ViewModel.Recipes)
        {
            <tr>
                <td>@recipe.RecipeId</td>
                <td>@recipe.Name</td>
                <td>
                    <table>
                        <thead>
                            <tr>
                                <th>Ingredient ID</th>
                                <th>Ingredient Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ingredient in recipe.Ingredients ?? [])
                            {
                                <tr>
                                    <td>@ingredient.IngredientId</td>
                                    <td>@ingredient.Name</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </td>
                <td>
                    <button @onclick="() => this.ViewModel.DeleteCommand.ExecuteAsync(recipe.RecipeId)" />
                </td>
            </tr>
        }
    </tbody>
</table>

