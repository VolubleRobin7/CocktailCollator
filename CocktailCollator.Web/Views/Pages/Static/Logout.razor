@using CocktailCollator.Infrastructure.Persistence.Models
@using Microsoft.AspNetCore.Identity

@inject SignInManager<CocktailUser> SignInManager

@page "/logout"

<PageTitle>Logging Out</PageTitle>

<div class="container-sm mt-5">
    <div class="row justify-content-center">
        <div class="col-11 col-sm-10 col-md-8 card">
            <div class="card-body px-3 py-4 text-center">
                <h2 class="card-title mb-4">Logging Out</h2>
                <p class="text-muted">Please wait while we sign you out...</p>
                <div class="spinner-border text-primary mt-3" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await this.SignInManager.SignOutAsync();
        this.HttpContext?.Response.Redirect("/login");
    }
}
