@using CocktailCollator.Infrastructure.Persistence.Models
@using Microsoft.AspNetCore.Identity
@using System.ComponentModel.DataAnnotations

@inject SignInManager<CocktailUser> SignInManager

@page "/login"

<PageTitle>Login</PageTitle>

<div class="container-sm mt-5">
    <div class="row justify-content-center">
        <div class="col-6 card">
            <div class="card-body px-3 py-4">
                <h2 class="card-title mb-4 text-center">Login</h2>

                @if (!string.IsNullOrEmpty(this._errorMessage))
                {
                    <div class="alert alert-danger alert-dismissible"
                         role="alert">

                        @this._errorMessage

                        <button @onclick="() => this._errorMessage = string.Empty"
                                class="btn-close"
                                data-bs-dismiss="alert"
                                type="button" />
                    </div>
                }

                <EditForm FormName="login" 
                          Model="this.LoginForm" 
                          OnValidSubmit="this.LoginAsync" 
                          method="post">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label"
                               for="username">
                            Username
                        </label>

                        <InputText @bind-Value="LoginForm.Username"
                                   aria-required="true"
                                   autocomplete="username"
                                   class="form-control"
                                   id="username"
                                   placeholder="johnDoe" />

                        <ValidationMessage For="@(() => LoginForm.Username)"
                                           class="text-danger d-block mt-1" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label"
                               for="password">
                            Password
                        </label>

                        <InputText @bind-Value="LoginForm.Password"
                                   aria-required="true"
                                   autocomplete="current-password"
                                   class="form-control"
                                   id="password"
                                   placeholder="Password"
                                   type="password" />

                        <ValidationMessage For="@(() => LoginForm.Password)"
                                           class="text-danger d-block mt-1" />
                    </div>

                    <div class="mb-3 form-check">
                        <InputCheckbox @bind-Value="LoginForm.RememberMe"
                                       class="form-check-input"
                                       id="rememberMe" />

                        <label class="form-check-label" 
                               for="rememberMe">
                            Remember me
                        </label>
                    </div>

                    <button type="submit" class="w-100 btn btn-primary mb-3">Log In</button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private string _errorMessage = string.Empty;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    private LoginFormModel LoginForm { get; set; } = new();

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        if (HttpContext?.User?.Identity?.IsAuthenticated == true)
            this.HttpContext.Response.Redirect("/");
    }

    private async Task LoginAsync()
    {
        try
        {
            this._errorMessage = string.Empty;

            if (string.IsNullOrWhiteSpace(this.LoginForm.Username) || string.IsNullOrWhiteSpace(this.LoginForm.Password))
            {
                this._errorMessage = "Username and password are required.";
                return;
            }

            var _Result = await this.SignInManager.PasswordSignInAsync(
                this.LoginForm.Username,
                this.LoginForm.Password,
                this.LoginForm.RememberMe,
                false);

            if (_Result.Succeeded)
            {
                var redirectUrl = Uri.IsWellFormedUriString(this.ReturnUrl, UriKind.Relative)
                    ? this.ReturnUrl
                    : "/";
                this.HttpContext?.Response.Redirect(redirectUrl);
            }
            else
                this._errorMessage = "Invalid username or password.";
        }
        catch (Exception ex)
        {
            this._errorMessage = $"An error occurred during login: {ex.Message}";
        }
    }

    private sealed class LoginFormModel
    {
        [Required(ErrorMessage = "Username is required")]
        public string Username { get; set; } = "";

        [Required(ErrorMessage = "Password is required")]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; } = false;
    }
}
