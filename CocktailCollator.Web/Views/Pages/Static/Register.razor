@using CocktailCollator.Infrastructure.Persistence.Models
@using Microsoft.AspNetCore.Identity
@using System.ComponentModel.DataAnnotations

@inject SignInManager<CocktailUser> SignInManager
@inject UserManager<CocktailUser> UserManager

@page "/register"

<PageTitle>Register</PageTitle>

<div class="container-sm mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 card">
            <div class="card-body px-3 py-4">
                <h2 class="card-title mb-4 text-center">Create Account</h2>

                @if (!string.IsNullOrEmpty(this._errorMessage))
                {
                    <div class="alert alert-danger alert-dismissible"
                         role="alert">

                        @this._errorMessage

                        <button @onclick="() => this._errorMessage = string.Empty"
                                class="btn-close"
                                data-bs-dismiss="alert"
                                type="button" />
                    </div>
                }

                <EditForm FormName="register"
                          Model="this.RegisterForm"
                          OnValidSubmit="this.RegisterAsync"
                          method="post">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label"
                               for="username">
                            Username
                        </label>

                        <InputText @bind-Value="this.RegisterForm.Username"
                                   aria-required="true"
                                   autocomplete="username"
                                   class="form-control"
                                   id="username"
                                   placeholder="johnDoe" />

                        <ValidationMessage For="@(() => this.RegisterForm.Username)"
                                           class="text-danger d-block mt-1" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label"
                               for="password">
                            Password
                        </label>

                        <InputText @bind-Value="this.RegisterForm.Password"
                                   type="password"
                                   aria-required="true"
                                   autocomplete="new-password"
                                   class="form-control"
                                   id="password"
                                   placeholder="Password" />

                        <ValidationMessage For="@(() => this.RegisterForm.Password)"
                                           class="text-danger d-block mt-1" />

                        <small class="form-text text-muted d-block mt-1">
                            Password must be at least 6 characters long. TEMP
                        </small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label"
                               for="confirmPassword">
                            Confirm Password
                        </label>

                        <InputText @bind-Value="this.RegisterForm.ConfirmPassword"
                                   type="password"
                                   aria-required="true"
                                   autocomplete="new-password"
                                   class="form-control"
                                   id="confirmPassword"
                                   placeholder="Confirm Password" />

                        <ValidationMessage For="@(() => this.RegisterForm.ConfirmPassword)"
                                           class="text-danger d-block mt-1" />
                    </div>

                    <button type="submit" 
                            class="w-100 btn btn-primary mb-3">
                        Register
                    </button>
                </EditForm>

                <div class="text-center">
                    <p class="mb-0">
                        Already have an account?
                        <a href="/login" class="link-primary">Login here</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string _errorMessage = string.Empty;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    private RegisterFormModel RegisterForm { get; set; } = new();

    private async Task RegisterAsync()
    {
        try
        {
            this._errorMessage = string.Empty;

            var _User = new CocktailUser
            {
                UserName = this.RegisterForm.Username,
            };

            var _Result = await this.UserManager.CreateAsync(_User, this.RegisterForm.Password);

            if (_Result.Succeeded)
                this.HttpContext?.Response.Redirect("/redirect?RedirectType=register");
            else
            {
                var _ErrorMessages = string.Join(" ", _Result.Errors.Select(e => e.Description));
                this._errorMessage = $"Registration failed: {_ErrorMessages}";
            }
        }
        catch (Exception ex)
        {
            this._errorMessage = $"An error occurred during registration: {ex.Message}";
        }
    }

    private sealed class RegisterFormModel
    {
        [Required(ErrorMessage = "Username is required")]
        public string Username { get; set; } = "";

        [Required(ErrorMessage = "Password is required")]
        //[StringLength(100, MinimumLength = 6, ErrorMessage = "Password must be between 6 and 100 characters")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Please confirm your password")]
        [Compare("Password", ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = "";
    }
}
