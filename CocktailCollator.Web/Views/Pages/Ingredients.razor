@using CocktailCollator.Web.ViewModels.IngredientCategories
@using CocktailCollator.Web.ViewModels.Ingredients
@using CocktailCollator.Web.Views.Components.Buttons
@using CocktailCollator.Web.Views.Modals
@using Microsoft.AspNetCore.Components.Authorization

@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IngredientsViewModel ViewModel
@inject IngredientCategoriesViewModel IngredientCategoriesViewModel

@attribute [Authorize(Policy = Policies.ViewIngredients)]

@page "/ingredients"

<PageTitle>Ingredients</PageTitle>

<div class="container">
    <div class="row">
        
        <!-- Left Pane: Categories -->
        <div class="col-md-4 col-lg-3 pe-md-4">
            <h4 class="mb-4">Categories</h4>
            
            <div class="d-grid gap-2 mb-4">
                <Button @onclick="this.IngredientCategoriesViewModel.GetCommand.ExecuteAsync"
                        Text="Get Categories"
                        Theme="ButtonTheme.Primary" />

                <AuthorizeView Policy="@Policies.ManageIngredients">
                    <Button @onclick="() => this._createIngredientCategoryModal.OpenModalAsync()"
                            Text="Create Category"
                            Theme="ButtonTheme.Secondary" />
                </AuthorizeView>
            </div>

            <div class="list-group list-group-flush mb-3">
                @foreach (var ingredientCategory in this.IngredientCategoriesViewModel.IngredientCategories)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center py-3 px-0 bg-transparent border-bottom">
                        <span class="fw-medium">@ingredientCategory.Name</span>

                        <AuthorizeView Policy="@Policies.ManageIngredients">
                            <span @onclick="() => this.IngredientCategoriesViewModel.DeleteCommand.ExecuteAsync(ingredientCategory.IngredientCategoryId)"
                                  class="text-danger opacity-50 cursor-pointer user-select-none hover-opacity-100 fs-5 lh-1" 
                                  title="Remove">
                                &times;
                            </span>
                        </AuthorizeView>
                    </div>
                }
            </div>
        </div>

        <!-- Right Pane: Ingredients -->
        <div class="col-md-8 col-lg-9 border-start ps-md-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <h4 class="m-0">Ingredients</h4>

                <div class="d-grid d-md-flex gap-2">
                    <Button @onclick="this.ViewModel.GetCommand.ExecuteAsync"
                            Text="Get Ingredients"
                            Theme="ButtonTheme.Primary" />

                    <AuthorizeView Policy="@Policies.ManageIngredients">
                        <Button Text="Create Ingredient"
                                Theme="ButtonTheme.Secondary" />
                    </AuthorizeView>
                </div>
            </div>

            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var ingredient in this.ViewModel.Ingredients)
                {
                    <div class="col">
                        <article @onclick="() => this.OpenUpdateIngredientModalAsync(ingredient.IngredientId)" 
                                 class="card h-100 shadow-sm ingredient-card border-0">

                            <div class="card-body position-relative d-flex flex-row align-items-center gap-3">
                                <AuthorizeView Policy="@Policies.ManageIngredients">
                                    <span @onclick="() => this.ViewModel.DeleteCommand.ExecuteAsync(ingredient.IngredientId)"
                                          @onclick:stopPropagation="true"
                                          class="text-danger position-absolute top-0 end-0 m-2 opacity-50 cursor-pointer user-select-none hover-opacity-100 fs-5 lh-1"
                                          title="Remove">
                                        &times;
                                    </span>
                                </AuthorizeView>

                                <div class="flex-shrink-0">
                                    <img alt="@ingredient.Name" 
                                         class="rounded-circle object-fit-cover shadow-sm border border-light ingredient-thumb" 
                                         src="/images/placeholder.jpg" />
                                </div>

                                <div class="d-flex flex-column text-start flex-grow-1 w-100">
                                    <h5 class="card-title mb-1 fs-6 pe-3">@ingredient.Name</h5>

                                    @if (ingredient.Category is not null)
                                    {
                                        <div class="mt-1">
                                            <span class="badge rounded-pill fw-normal ingredient-category">
                                                @ingredient.Category.Name
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>

                        </article>
                    </div>
                }
            </div>
        </div>
        
    </div>
</div>

<CreateIngredientCategoryModal @ref="this._createIngredientCategoryModal"
                               OnAfterCreation="this.StateHasChanged" />

<UpdateIngredientModal @ref="this._updateIngredientModal"
                       OnAfterUpdate="this.StateHasChanged" />

@code {
    private bool _canManageIngredients;
    private CreateIngredientCategoryModal _createIngredientCategoryModal = default!;
    private UpdateIngredientModal _updateIngredientModal = default!;

    protected override async Task OnInitializedAsync()
    {
        var authState = await this.AuthenticationStateProvider.GetAuthenticationStateAsync();
        var authResult = await this.AuthorizationService.AuthorizeAsync(authState.User, Policies.ManageIngredients);
        this._canManageIngredients = authResult.Succeeded;
    }

    private async Task OpenUpdateIngredientModalAsync(Guid ingredientId)
    {
        if (this._canManageIngredients)
            await this._updateIngredientModal.OpenModalAsync(ingredientId);
    }
}
