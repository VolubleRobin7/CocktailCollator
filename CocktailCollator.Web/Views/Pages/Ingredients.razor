@using CocktailCollator.Web.ViewModels.IngredientCategories
@using CocktailCollator.Web.ViewModels.Ingredients
@using CocktailCollator.Web.Views.Components.Buttons
@using CocktailCollator.Web.Views.Components.Navbars

@inject IngredientsViewModel ViewModel
@inject IngredientCategoriesViewModel IngredientCategoriesViewModel

@page "/ingredients"

<PageTitle>Ingredients</PageTitle>

<Navbar CurrentPage="ingredients" />

<div class="container pt-2">

    <Button @onclick="this.ViewModel.GetCommand.ExecuteAsync"
            Theme="ButtonTheme.Secondary"
            Text="Get Ingredients" />
            
    <Button @onclick="@(() => this.IngredientCategoriesViewModel.CreateCommand.ExecuteAsync(new() { Name = "Test Category" }))"
            Text="Create Ingredient Category"
            Theme="ButtonTheme.Warning" />

    <ul class="list-group list-group-flush">
        @foreach (var ingredient in this.ViewModel.Ingredients)
        {
            <li class="list-group-item">
                <div class="d-flex justify-content-between">
                    <span class="align-content-center">
                        @ingredient.Name
                    </span>
                    <Button @onclick="() => this.ViewModel.DeleteCommand.ExecuteAsync(ingredient.IngredientId)"
                            Size="ButtonSize.Small"
                            Theme="ButtonTheme.Danger"
                            Text="Remove" />
                </div>
            </li>
        }
    </ul>

</div>

<p>@this.ViewModel.Error</p>

