@using CocktailCollator.Web.FormModels.Measurements
@using CocktailCollator.Web.ViewModels.Measurements
@using CocktailCollator.Web.Views.Components.Buttons
@using CocktailCollator.Web.Views.Components.Inputs
@using CocktailCollator.Web.Views.Components.Modals

@inject CreateMeasurementFormModel CreateMeasurementFormModel
@inject MeasurementsViewModel ViewModel

<Modal @ref="this._modal" 
       Title="Create Measurement">

    <Body>
        <form>
            <h3>New Measurement</h3>

            <InputField Input="this.CreateMeasurementFormModel.Name"
                        InvalidMessage="Name requires a value."
                        Title="Measurement Name" />

            <Button @onclick="this.OnClickCreate"
                    Size="ButtonSize.Large"
                    Theme="ButtonTheme.Success"
                    Text="Save Recipe"
                    class="mt-2"
                    data-bs-dismiss="modal"
                    disabled="@(!this.CreateMeasurementFormModel.IsValid())" />
        </form>
    </Body>

</Modal>

@code {
    private Modal _modal = default!;

    [Parameter]
    public EventCallback OnAfterCreation { get; set; }

    private async Task OnClickCreate()
    {
        await this.ViewModel.CreateCommand.ExecuteAsync(this.CreateMeasurementFormModel.ExtractToInputPort());
        this.CreateMeasurementFormModel.ResetToDefault();
        await this.OnAfterCreation.InvokeAsync();
    }

    public Task OpenModalAsync()
        => this._modal.OpenModalAsync();
}
