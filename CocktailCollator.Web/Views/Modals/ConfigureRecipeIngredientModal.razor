@using System.Diagnostics.CodeAnalysis
@using CocktailCollator.Web.FormModels.Recipes
@using CocktailCollator.Web.ViewModels.Ingredients
@using CocktailCollator.Web.ViewModels.Measurements
@using CocktailCollator.Web.Views.Components.Buttons
@using CocktailCollator.Web.Views.Components.Inputs
@using CocktailCollator.Web.Views.Components.Modals

@inject IngredientsViewModel IngredientsViewModel
@inject MeasurementsViewModel MeasurementsViewModel

<Modal @ref="this._modal"
       Size="ModalSize.Large"
       Title="@(this._isEditingExisting ? "Edit Ingredient" : "Add Ingredient")">

    <Body>
        <div class="accordion">
            @* Accordion Section 1: Ingredient *@
            <div class="accordion-item">
                <h2 class="accordion-header" id="@this._headingIngredientId">
                    <button class="accordion-button @(this._activeSection != AccordionSection.Ingredient ? "collapsed" : "")"
                            type="button"
                            @onclick="() => this.ToggleSection(AccordionSection.Ingredient)">

                        <div class="d-flex justify-content-between align-items-center w-100 me-3">
                            <span class="fw-semibold">1. Ingredient</span>
                            @if (!string.IsNullOrWhiteSpace(this._ingredient.Name.Input))
                            {
                                <span class="badge bg-primary">@this._ingredient.Name.Input</span>
                            }
                        </div>

                    </button>
                </h2>

                <div class="accordion-collapse collapse @(this._activeSection == AccordionSection.Ingredient ? "show" : "")"
                     aria-labelledby="@this._headingIngredientId">

                    <div class="accordion-body accordion-step-body">
                        <div class="mb-3">
                            <label class="form-label text-muted small">Search existing ingredients or create a new one</label>

                            <div class="input-group">
                                <input @bind-value:event="oninput"
                                       @bind-value:get="this._ingredientSearchString"
                                       @bind-value:set="this.SetIngredientSearchValue"
                                       class="form-control"
                                       placeholder="Type to search ingredients..."
                                       type="text" />

                                @if (!string.IsNullOrEmpty(this._ingredientSearchString))
                                {
                                    <button class="btn btn-outline-secondary" type="button" @onclick="() => this.SetIngredientSearchValue(string.Empty)">
                                        ✕
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="list-group mb-3 overflow-auto selector-scroll-list">
                            @foreach (var ingredient in this._ingredientSearchResults)
                            {
                                var isSelected = this._ingredient.UsingExistingIngredient && this._ingredient.ExistingIngredientId == ingredient.IngredientId;
                                <button type="button"
                                        class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(isSelected ? "active" : "")"
                                        @onclick="() => this.SelectExistingIngredient(ingredient)">

                                    <span>@ingredient.Name</span>
                                    @if (isSelected)
                                    {
                                        <span class="badge bg-light text-dark">Selected</span>
                                    }

                                </button>
                            }

                            @if (!this._ingredientSearchResults.Any())
                            {
                                <div class="p-3 text-center text-muted small">
                                    No matching ingredients found.
                                </div>
                            }

                            <button type="button"
                                    class="list-group-item list-group-item-action list-group-item-light border-top @(!this._ingredient.UsingExistingIngredient && !string.IsNullOrWhiteSpace(this._ingredient.Name.Input) ? "active" : "")"
                                    @onclick="this.EnableCreateNewIngredient">

                                <div class="d-flex align-items-center">
                                    <span class="me-2">＋</span>
                                    <span>Create new ingredient@(string.IsNullOrWhiteSpace(this._ingredientSearchString) ? "..." : $": \"{this._ingredientSearchString}\"")</span>
                                </div>
                            </button>

                        </div>

                        @if (!this._ingredient.UsingExistingIngredient)
                        {
                            <div class="card p-3 mb-3 bg-light border">
                                <InputField Input="this._ingredient.Name"
                                            Title="New Ingredient Name" />
                            </div>
                        }
                    </div>

                </div>
            </div>

            @* Accordion Section 2: Measurement *@
            <div class="accordion-item">
                <h2 class="accordion-header" id="@this._headingMeasurementId">
                    <button class="accordion-button @(this._activeSection != AccordionSection.Measurement ? "collapsed" : "")"
                            type="button"
                            disabled="@(!this._ingredient.Name.IsValid())"
                            @onclick="() => this.ToggleSection(AccordionSection.Measurement)">

                        <div class="d-flex justify-content-between align-items-center w-100 me-3">
                            <span class="fw-semibold">2. Measurement Type</span>
                            @if (this._ingredient.MeasurementModel is not null)
                            {
                                <span class="badge bg-primary">@this._ingredient.MeasurementModel.Name</span>
                            }
                        </div>

                    </button>
                </h2>

                <div class="accordion-collapse collapse @(this._activeSection == AccordionSection.Measurement ? "show" : "")"
                     aria-labelledby="@this._headingMeasurementId">

                    <div class="accordion-body accordion-step-body">
                        <div class="mb-3">
                            <label class="form-label text-muted small">Search measurement types (e.g., ml, oz, dash, tsp)</label>

                            <div class="input-group">
                                <input @bind-value:event="oninput"
                                       @bind-value:get="this._measurementSearchString"
                                       @bind-value:set="this.SetMeasurementSearchValue"
                                       class="form-control"
                                       placeholder="Type to search measurements..."
                                       type="text" />

                                @if (!string.IsNullOrEmpty(this._measurementSearchString))
                                {
                                    <button class="btn btn-outline-secondary" type="button" @onclick="() => this.SetMeasurementSearchValue(string.Empty)">
                                        ✕
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="list-group mb-3 overflow-auto selector-scroll-list">
                            @foreach (var measurement in this._measurementSearchResults)
                            {
                                var isSelected = this._ingredient.MeasurementModel?.MeasurementId == measurement.MeasurementId;
                                <button type="button"
                                        class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(isSelected ? "active" : "")"
                                        @onclick="() => this.SelectMeasurement(measurement)">

                                    <span>@measurement.Name</span>
                                    @if (isSelected)
                                    {
                                        <span class="badge bg-light text-dark">Selected</span>
                                    }

                                </button>
                            }

                            @if (!this._measurementSearchResults.Any())
                            {
                                <div class="p-3 text-center text-muted small">
                                    No matching measurements found.
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @* Accordion Section 3: Amount *@
            <div class="accordion-item">
                <h2 class="accordion-header" id="@this._headingAmountId">
                    <button class="accordion-button @(this._activeSection != AccordionSection.Amount ? "collapsed" : "")"
                            type="button"
                            disabled="@(this._ingredient.MeasurementModel is null)"
                            @onclick="() => this.ToggleSection(AccordionSection.Amount)">

                        <div class="d-flex justify-content-between align-items-center w-100 me-3">
                            <span class="fw-semibold">3. Amount</span>
                            @if (this._ingredient.Amount.Input > 0)
                            {
                                <span class="badge bg-primary">@this._ingredient.Amount.Input @(this._ingredient.MeasurementModel?.Name ?? "")</span>
                            }
                        </div>

                    </button>
                </h2>
                <div class="accordion-collapse collapse @(this._activeSection == AccordionSection.Amount ? "show" : "")"
                     aria-labelledby="@this._headingAmountId">

                    <div class="accordion-body">
                        <div class="py-2">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Amount @(this._ingredient.MeasurementModel is not null ? $"({this._ingredient.MeasurementModel.Name})" : "")
                                </label>

                                <div class="input-group input-group-lg">
                                    <input @bind-value="this._ingredient.Amount.Input"
                                           @bind-value:event="oninput"
                                           class="form-control"
                                           min="0.01"
                                           step="any"
                                           type="number"
                                           placeholder="e.g. 30" />

                                    @if (this._ingredient.MeasurementModel is not null)
                                    {
                                        <span class="input-group-text">@this._ingredient.MeasurementModel.Name</span>
                                    }
                                </div>

                                <div class="form-text mt-2 text-muted">
                                    Enter the amount of @(string.IsNullOrWhiteSpace(this._ingredient.Name.Input) ? "ingredient" : this._ingredient.Name.Input) to add to the recipe.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Ingredient Preview *@
        <div class="mt-3">
            <div class="text-secondary small text-uppercase fw-semibold mb-2">Preview</div>

            <div class="card p-3 bg-light border">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-medium">
                        @(string.IsNullOrWhiteSpace(this._ingredient.Name.Input) ? "Select an ingredient..." : this._ingredient.Name.Input)
                    </span>

                    <span class="text-secondary small">
                        @if (!string.IsNullOrWhiteSpace(this._ingredient.Name.Input) && this._ingredient.MeasurementModel is not null && this._ingredient.Amount.Input > 0)
                        {
                            <span>@this._ingredient.Amount.Input @this._ingredient.MeasurementModel.Name</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(this._ingredient.Name.Input) && this._ingredient.MeasurementModel is not null)
                        {
                            <span>@this._ingredient.Amount.Input @this._ingredient.MeasurementModel.Name</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(this._ingredient.Name.Input))
                        {
                            <span class="text-muted fst-italic">Select measurement & amount...</span>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Click to configure</span>
                        }
                    </span>
                </div>
            </div>
        </div>
    </Body>

    <Footer>
        <Button Text="Cancel"
                Theme="ButtonTheme.Secondary"
                data-bs-dismiss="modal" />

        <Button @onclick="this.OnClickAddAsync"
                Text="@(this._isEditingExisting ? "Save" : "Add")"
                Theme="ButtonTheme.Success"
                data-bs-dismiss="modal"
                disabled="@(!this.IsAllCompleted())" />
    </Footer>

</Modal>

@code {
    private enum AccordionSection
    {
        Ingredient,
        Measurement,
        Amount
    }

    // ARIA labels
    private readonly string _headingIngredientId = $"head_ing_{Guid.NewGuid():N}";
    private readonly string _headingMeasurementId = $"head_meas_{Guid.NewGuid():N}";
    private readonly string _headingAmountId = $"head_amt_{Guid.NewGuid():N}";

    // Form data
    private RecipeFormModelIngredient _ingredient = new();

    // Fields
    private AccordionSection _activeSection = AccordionSection.Ingredient;
    private Modal _modal = default!;
    private string _ingredientSearchString = string.Empty;
    private List<IngredientViewModel> _ingredientSearchResults = [];
    private string _measurementSearchString = string.Empty;
    private List<MeasurementViewModel> _measurementSearchResults = [];
    private RecipeFormModelIngredient? _targetIngredient;

    [MemberNotNullWhen(true, nameof(_targetIngredient))]
    private bool _isEditingExisting => this._targetIngredient is not null;

    [Parameter]
    public EventCallback<RecipeFormModelIngredient> OnIngredientUpdated { get; set; }

    public async Task OpenModalAsync(RecipeFormModelIngredient? ingredient = null)
    {
        this._targetIngredient = ingredient;

        if (!this.IngredientsViewModel.Ingredients.Any())
            await this.IngredientsViewModel.GetCommand.ExecuteAsync(default);

        if (!this.MeasurementsViewModel.Measurements.Any())
            await this.MeasurementsViewModel.GetCommand.ExecuteAsync(default);

        this.InitializeWorkingCopy();
        await this._modal.OpenModalAsync();
    }

    private void InitializeWorkingCopy()
    {
        this._activeSection = AccordionSection.Ingredient;

        this._ingredient = new RecipeFormModelIngredient();
        if (this._targetIngredient is not null)
            this._targetIngredient.CopyTo(this._ingredient);

        this._ingredient.Name.OnChange = this.StateHasChanged;

        this.SetIngredientSearchValue(string.Empty);
        this.SetMeasurementSearchValue(string.Empty);
    }

    private void ToggleSection(AccordionSection section)
    {
        if (section == AccordionSection.Measurement && !this._ingredient.Name.IsValid())
            return;

        if (section == AccordionSection.Amount && this._ingredient.MeasurementModel is null)
            return;

        this._activeSection = section;
    }

    private void SelectExistingIngredient(IngredientViewModel ingredient)
    {
        this._ingredient.UsingExistingIngredient = true;
        this._ingredient.ExistingIngredientId = ingredient.IngredientId;
        this._ingredient.Name.Input = ingredient.Name ?? string.Empty;
        this._ingredient.MeasurementModel = null;
        this._ingredient.Measurement.ResetToDefault();
        this.SetMeasurementSearchValue(string.Empty);

        if (ingredient.Measurements?.Count == 1)
            this.SelectMeasurement(ingredient.Measurements.First());
        else
            this._activeSection = AccordionSection.Measurement;
    }

    private void EnableCreateNewIngredient()
    {
        this._ingredient.UsingExistingIngredient = false;
        this._ingredient.ExistingIngredientId = Guid.Empty;

        if (!string.IsNullOrWhiteSpace(this._ingredientSearchString))
            this._ingredient.Name.Input = this._ingredientSearchString.Trim();

        this.SetMeasurementSearchValue(string.Empty);
    }

    private void SelectMeasurement(MeasurementViewModel measurement)
    {
        this._ingredient.MeasurementModel = measurement;
        this._ingredient.Measurement.Input = measurement.MeasurementId;
        this._activeSection = AccordionSection.Amount;
    }

    private void SetIngredientSearchValue(string? value)
    {
        this._ingredientSearchString = value ?? string.Empty;
        this._ingredientSearchResults = this.IngredientsViewModel.Ingredients
            .Where(ingredient => ingredient.Name is not null && ingredient.Name.Contains(this._ingredientSearchString, StringComparison.OrdinalIgnoreCase))
            .Take(15)
            .ToList();
    }

    private void SetMeasurementSearchValue(string? value)
    {
        this._measurementSearchString = value ?? string.Empty;

        if (this._ingredient.UsingExistingIngredient && this._ingredient.ExistingIngredientId != Guid.Empty)
        {
            var selectedIngredient = this.IngredientsViewModel.Ingredients
                .FirstOrDefault(i => i.IngredientId == this._ingredient.ExistingIngredientId);

            this._measurementSearchResults = selectedIngredient?.Measurements?
                .Where(measurement => measurement.Name is not null && measurement.Name.Contains(this._measurementSearchString, StringComparison.OrdinalIgnoreCase))
                .ToList() ?? [];
        }
        else
        {
            this._measurementSearchResults = this.MeasurementsViewModel.Measurements
                .Where(measurement => measurement.Name is not null && measurement.Name.Contains(this._measurementSearchString, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private bool IsAllCompleted()
    {
        if (!this._ingredient.Name.IsValid())
            return false;

        if (this._ingredient.UsingExistingIngredient && this._ingredient.ExistingIngredientId == Guid.Empty)
            return false;

        if (this._ingredient.MeasurementModel is null || !this._ingredient.Measurement.IsValid())
            return false;

        if (!this._ingredient.Amount.IsValid())
            return false;

        return true;
    }

    private async Task OnClickAddAsync()
    {
        if (!this.IsAllCompleted())
            return;

        this._ingredient.Name.Input = this._ingredient.Name.Input.Trim();

        if (this._isEditingExisting)
        {
            this._ingredient.CopyTo(this._targetIngredient);
            await this.OnIngredientUpdated.InvokeAsync(this._targetIngredient);
        }
        else
            await this.OnIngredientUpdated.InvokeAsync(this._ingredient);

        await this._modal.CloseModalAsync();
    }
}
