@using CocktailCollator.Web.FormModels.Recipes
@using CocktailCollator.Web.ViewModels.Ingredients
@using CocktailCollator.Web.ViewModels.Measurements
@using CocktailCollator.Web.Views.Components.Buttons
@using CocktailCollator.Web.Views.Components.Modals

@inject IngredientsViewModel IngredientsViewModel
@inject MeasurementsViewModel MeasurementsViewModel

<Modal @ref="this._modal"
       Size="ModalSize.Large"
       Title="@(this._isEditingExisting ? "Edit Ingredient" : "Add Ingredient")">

    <Body>
        <div class="accordion">
            @* Accordion Section 1: Ingredient *@
            <div class="accordion-item">
                <h2 class="accordion-header" id="@this._headingIngredientId">
                    <button class="accordion-button @(this._activeSection != AccordionSection.Ingredient ? "collapsed" : "")"
                            type="button"
                            @onclick="() => this.ToggleSection(AccordionSection.Ingredient)">

                        <div class="d-flex justify-content-between align-items-center w-100 me-3">
                            <span class="fw-semibold">1. Ingredient</span>
                            @if (!string.IsNullOrWhiteSpace(this._ingredientName))
                            {
                                <span class="badge bg-primary">@this._ingredientName</span>
                            }
                        </div>

                    </button>
                </h2>

                <div class="accordion-collapse collapse @(this._activeSection == AccordionSection.Ingredient ? "show" : "")"
                     aria-labelledby="@this._headingIngredientId">

                    <div class="accordion-body accordion-step-body">
                        <div class="mb-3">
                            <label class="form-label text-muted small">Search existing ingredients or create a new one</label>

                            <div class="input-group">
                                <input @bind-value="this._ingredientSearchString"
                                       @bind-value:event="oninput"
                                       class="form-control"
                                       placeholder="Type to search ingredients..."
                                       type="text" />

                                @if (!string.IsNullOrEmpty(this._ingredientSearchString))
                                {
                                    <button class="btn btn-outline-secondary" type="button" @onclick="() => this._ingredientSearchString = string.Empty">
                                        ✕
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="list-group mb-3 overflow-auto selector-scroll-list">
                            @foreach (var ingredient in this.GetFilteredIngredients())
                            {
                                var isSelected = this._usingExistingIngredient && this._existingIngredientId == ingredient.IngredientId;
                                <button type="button"
                                        class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(isSelected ? "active" : "")"
                                        @onclick="() => this.SelectExistingIngredient(ingredient)">

                                    <span>@ingredient.Name</span>
                                    @if (isSelected)
                                    {
                                        <span class="badge bg-light text-dark">Selected</span>
                                    }

                                </button>
                            }

                            @if (!this.GetFilteredIngredients().Any())
                            {
                                <div class="p-3 text-center text-muted small">
                                    No matching ingredients found.
                                </div>
                            }

                            <button type="button"
                                    class="list-group-item list-group-item-action list-group-item-light border-top @(!this._usingExistingIngredient && !string.IsNullOrWhiteSpace(this._ingredientName) ? "active" : "")"
                                    @onclick="this.EnableCreateNewIngredient">

                                <div class="d-flex align-items-center">
                                    <span class="me-2">＋</span>
                                    <span>Create new ingredient@(string.IsNullOrWhiteSpace(this._ingredientSearchString) ? "..." : $": \"{this._ingredientSearchString}\"")</span>
                                </div>
                            </button>

                        </div>

                        @if (!this._usingExistingIngredient)
                        {
                            @* This could be a InputField if there was a custom form model for this modal (so that changes can be cancelled) *@
                            <div class="card p-3 mb-3 bg-light border">
                                <label class="form-label fw-semibold">New Ingredient Name</label>
                                <input @bind-value="this._ingredientName"
                                       @bind-value:event="oninput"
                                       class="form-control"
                                       placeholder="Enter custom ingredient name..."
                                       type="text" />
                            </div>
                        }
                    </div>

                </div>
            </div>

            @* Accordion Section 2: Measurement *@
            <div class="accordion-item">
                <h2 class="accordion-header" id="@this._headingMeasurementId">
                    <button class="accordion-button @(this._activeSection != AccordionSection.Measurement ? "collapsed" : "")"
                            type="button"
                            disabled="@(string.IsNullOrWhiteSpace(this._ingredientName))"
                            @onclick="() => this.ToggleSection(AccordionSection.Measurement)">

                        <div class="d-flex justify-content-between align-items-center w-100 me-3">
                            <span class="fw-semibold">2. Measurement Type</span>
                            @if (this._selectedMeasurement is not null)
                            {
                                <span class="badge bg-primary">@this._selectedMeasurement.Name</span>
                            }
                        </div>

                    </button>
                </h2>

                <div class="accordion-collapse collapse @(this._activeSection == AccordionSection.Measurement ? "show" : "")"
                     aria-labelledby="@this._headingMeasurementId">

                    <div class="accordion-body accordion-step-body">
                        <div class="mb-3">
                            <label class="form-label text-muted small">Search measurement types (e.g., ml, oz, dash, tsp)</label>

                            <div class="input-group">
                                <input @bind-value="this._measurementSearchString"
                                       @bind-value:event="oninput"
                                       class="form-control"
                                       placeholder="Type to search measurements..."
                                       type="text" />

                                @if (!string.IsNullOrEmpty(this._measurementSearchString))
                                {
                                    <button class="btn btn-outline-secondary" type="button" @onclick="() => this._measurementSearchString = string.Empty">
                                        ✕
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="list-group mb-3 overflow-auto selector-scroll-list">
                            @foreach (var measurement in this.GetFilteredMeasurements())
                            {
                                var isSelected = this._selectedMeasurement?.MeasurementId == measurement.MeasurementId;
                                <button type="button"
                                        class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(isSelected ? "active" : "")"
                                        @onclick="() => this.SelectMeasurement(measurement)">

                                    <span>@measurement.Name</span>
                                    @if (isSelected)
                                    {
                                        <span class="badge bg-light text-dark">Selected</span>
                                    }

                                </button>
                            }

                            @if (!this.GetFilteredMeasurements().Any())
                            {
                                <div class="p-3 text-center text-muted small">
                                    No matching measurements found.
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @* Accordion Section 3: Amount *@
            <div class="accordion-item">
                <h2 class="accordion-header" id="@this._headingAmountId">
                    <button class="accordion-button @(this._activeSection != AccordionSection.Amount ? "collapsed" : "")"
                            type="button"
                            disabled="@(this._selectedMeasurement is null)"
                            @onclick="() => this.ToggleSection(AccordionSection.Amount)">

                        <div class="d-flex justify-content-between align-items-center w-100 me-3">
                            <span class="fw-semibold">3. Amount</span>
                            @if (this._amount > 0)
                            {
                                <span class="badge bg-primary">@this._amount @(this._selectedMeasurement?.Name ?? "")</span>
                            }
                        </div>

                    </button>
                </h2>
                <div class="accordion-collapse collapse @(this._activeSection == AccordionSection.Amount ? "show" : "")"
                     aria-labelledby="@this._headingAmountId">

                    <div class="accordion-body">
                        <div class="py-2">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Amount @(this._selectedMeasurement is not null ? $"({this._selectedMeasurement.Name})" : "")
                                </label>

                                <div class="input-group input-group-lg">
                                    <input @bind-value="this._amount"
                                           @bind-value:event="oninput"
                                           class="form-control"
                                           min="0.01"
                                           step="any"
                                           type="number"
                                           placeholder="e.g. 30" />

                                    @if (this._selectedMeasurement is not null)
                                    {
                                        <span class="input-group-text">@this._selectedMeasurement.Name</span>
                                    }
                                </div>

                                <div class="form-text mt-2 text-muted">
                                    Enter the amount of @(string.IsNullOrWhiteSpace(this._ingredientName) ? "ingredient" : this._ingredientName) to add to the recipe.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Ingredient Preview *@
        <div class="mt-3">
            <div class="text-secondary small text-uppercase fw-semibold mb-2">Preview</div>

            <div class="card p-3 bg-light border">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-medium">
                        @(string.IsNullOrWhiteSpace(this._ingredientName) ? "Select an ingredient..." : this._ingredientName)
                    </span>

                    <span class="text-secondary small">
                        @if (!string.IsNullOrWhiteSpace(this._ingredientName) && this._selectedMeasurement is not null && this._amount > 0)
                        {
                            <span>@this._amount @this._selectedMeasurement.Name</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(this._ingredientName) && this._selectedMeasurement is not null)
                        {
                            <span>@this._amount @this._selectedMeasurement.Name</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(this._ingredientName))
                        {
                            <span class="text-muted fst-italic">Select measurement & amount...</span>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Click to configure</span>
                        }
                    </span>
                </div>
            </div>
        </div>
    </Body>

    <Footer>
        <Button Text="Cancel"
                Theme="ButtonTheme.Secondary"
                data-bs-dismiss="modal" />

        <Button @onclick="this.OnClickAddAsync"
                Text="@(this._isEditingExisting ? "Save" : "Add")"
                Theme="ButtonTheme.Success"
                data-bs-dismiss="modal"
                disabled="@(!this.IsAllCompleted())" />
    </Footer>

</Modal>

@code {
    private enum AccordionSection
    {
        Ingredient,
        Measurement,
        Amount
    }

    // ARIA labels
    private readonly string _headingIngredientId = $"head_ing_{Guid.NewGuid():N}";
    private readonly string _headingMeasurementId = $"head_meas_{Guid.NewGuid():N}";
    private readonly string _headingAmountId = $"head_amt_{Guid.NewGuid():N}";

    // Form data
    private decimal _amount = 1m;
    private Guid _existingIngredientId = Guid.Empty;
    private string _ingredientName = string.Empty;
    private IngredientViewModel? _selectedIngredient;
    private MeasurementViewModel? _selectedMeasurement;
    private bool _usingExistingIngredient = true;

    // Fields
    private AccordionSection _activeSection = AccordionSection.Ingredient;
    private Modal _modal = default!;
    private string _ingredientSearchString = string.Empty;
    private string _measurementSearchString = string.Empty;
    private UpdateRecipeFormModelIngredient? _targetIngredient;

    private bool _isEditingExisting => this._targetIngredient is not null;

    [Parameter]
    public EventCallback<UpdateRecipeFormModelIngredient> OnIngredientUpdated { get; set; }

    public async Task OpenModalAsync(UpdateRecipeFormModelIngredient? ingredient = null)
    {
        this._targetIngredient = ingredient;

        if (!this.IngredientsViewModel.Ingredients.Any())
            await this.IngredientsViewModel.GetCommand.ExecuteAsync(default);

        if (!this.MeasurementsViewModel.Measurements.Any())
            await this.MeasurementsViewModel.GetCommand.ExecuteAsync(default);

        this.InitializeWorkingCopy();
        await this._modal.OpenModalAsync();
    }

    private void InitializeWorkingCopy()
    {
        this._activeSection = AccordionSection.Ingredient;
        this._ingredientSearchString = string.Empty;
        this._measurementSearchString = string.Empty;

        if (this._targetIngredient is not null)
        {
            this._ingredientName = this._targetIngredient.Name.Input ?? string.Empty;
            this._usingExistingIngredient = this._targetIngredient.UsingExistingIngredient;
            this._existingIngredientId = this._targetIngredient.ExistingIngredientId;
            this._amount = this._targetIngredient.Amount.Input > 0 ? this._targetIngredient.Amount.Input : 1m;

            if (this._usingExistingIngredient && this._existingIngredientId != Guid.Empty)
            {
                this._selectedIngredient = this.IngredientsViewModel.Ingredients
                    .FirstOrDefault(i => i.IngredientId == this._existingIngredientId);
            }
            else
            {
                this._selectedIngredient = null;
            }

            if (this._targetIngredient.MeasurementModel is not null)
            {
                this._selectedMeasurement = this._targetIngredient.MeasurementModel;
            }
            else if (this._targetIngredient.Measurement.Input != Guid.Empty)
            {
                this._selectedMeasurement = this.MeasurementsViewModel.Measurements
                    .FirstOrDefault(m => m.MeasurementId == this._targetIngredient.Measurement.Input);
            }
            else
            {
                this._selectedMeasurement = null;
            }
        }
        else
        {
            this._ingredientName = string.Empty;
            this._usingExistingIngredient = true;
            this._existingIngredientId = Guid.Empty;
            this._selectedIngredient = null;
            this._selectedMeasurement = null;
            this._amount = 1m;
        }
    }

    private void ToggleSection(AccordionSection section)
    {
        if (section == AccordionSection.Measurement && string.IsNullOrWhiteSpace(this._ingredientName))
            return;

        if (section == AccordionSection.Amount && this._selectedMeasurement is null)
            return;

        this._activeSection = section;
    }

    private void SelectExistingIngredient(IngredientViewModel ingredient)
    {
        this._usingExistingIngredient = true;
        this._selectedIngredient = ingredient;
        this._existingIngredientId = ingredient.IngredientId;
        this._ingredientName = ingredient.Name ?? string.Empty;

        if (ingredient.Measurements?.Count == 1)
        {
            this._selectedMeasurement = ingredient.Measurements.First();
        }
        else if (this._selectedMeasurement is not null && ingredient.Measurements?.Any() == true)
        {
            if (!ingredient.Measurements.Any(m => m.MeasurementId == this._selectedMeasurement.MeasurementId))
            {
                this._selectedMeasurement = null;
            }
        }

        this._activeSection = AccordionSection.Measurement;
    }

    private void EnableCreateNewIngredient()
    {
        this._usingExistingIngredient = false;
        this._existingIngredientId = Guid.Empty;
        this._selectedIngredient = null;

        if (!string.IsNullOrWhiteSpace(this._ingredientSearchString))
            this._ingredientName = this._ingredientSearchString.Trim();
    }

    private void SelectMeasurement(MeasurementViewModel measurement)
    {
        this._selectedMeasurement = measurement;
        this._activeSection = AccordionSection.Amount;
    }

    private IEnumerable<IngredientViewModel> GetFilteredIngredients()
    {
        var search = this._ingredientSearchString?.Trim() ?? string.Empty;
        var all = this.IngredientsViewModel.Ingredients;

        if (string.IsNullOrEmpty(search))
            return all.Take(15);

        return all
            .Where(i => i.Name is not null && i.Name.Contains(search, StringComparison.OrdinalIgnoreCase))
            .Take(15);
    }

    private IEnumerable<MeasurementViewModel> GetFilteredMeasurements()
    {
        var search = this._measurementSearchString?.Trim() ?? string.Empty;

        if (this._usingExistingIngredient && this._selectedIngredient?.Measurements?.Any() == true)
        {
            var ingMeasurements = this._selectedIngredient.Measurements;
            if (string.IsNullOrEmpty(search))
                return ingMeasurements;

            var matched = ingMeasurements
                .Where(m => m.Name is not null && m.Name.Contains(search, StringComparison.OrdinalIgnoreCase))
                .ToList();

            if (matched.Any())
                return matched;
        }

        var all = this.MeasurementsViewModel.Measurements;
        if (string.IsNullOrEmpty(search))
            return all;

        return all
            .Where(m => m.Name is not null && m.Name.Contains(search, StringComparison.OrdinalIgnoreCase));
    }

    private bool IsAllCompleted()
    {
        if (string.IsNullOrWhiteSpace(this._ingredientName))
            return false;

        if (this._usingExistingIngredient && this._existingIngredientId == Guid.Empty)
            return false;

        if (this._selectedMeasurement is null || this._selectedMeasurement.MeasurementId == Guid.Empty)
            return false;

        if (this._amount <= 0)
            return false;

        return true;
    }

    private async Task OnClickAddAsync()
    {
        if (!this.IsAllCompleted())
            return;

        var target = this._targetIngredient ?? new UpdateRecipeFormModelIngredient();
        target.Name.Input = this._ingredientName.Trim();
        target.UsingExistingIngredient = this._usingExistingIngredient;
        target.ExistingIngredientId = this._existingIngredientId;
        target.Measurement.Input = this._selectedMeasurement!.MeasurementId;
        target.MeasurementModel = this._selectedMeasurement;
        target.Amount.Input = this._amount;

        await this.OnIngredientUpdated.InvokeAsync(target);
        await this._modal.CloseModalAsync();
    }
}
