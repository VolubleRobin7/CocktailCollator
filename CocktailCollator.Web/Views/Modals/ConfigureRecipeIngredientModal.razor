@using System.Diagnostics.CodeAnalysis
@using CocktailCollator.Web.FormModels.Recipes
@using CocktailCollator.Web.ViewModels.Ingredients
@using CocktailCollator.Web.ViewModels.Measurements
@using CocktailCollator.Web.Views.Components.Accordions
@using CocktailCollator.Web.Views.Components.Buttons
@using CocktailCollator.Web.Views.Components.Inputs
@using CocktailCollator.Web.Views.Components.Modals

@inject IngredientsViewModel IngredientsViewModel
@inject MeasurementsViewModel MeasurementsViewModel

<Modal @ref="this._modal"
       Size="ModalSize.Large"
       Title="@(this.IsEditingExisting ? "Edit Ingredient" : "Add Ingredient")">

    <Body>
        <Accordion>
            @* Accordion Section 1: Ingredient *@
            <AccordionItem @ref="this._ingredientSection"
                           Title="1. Ingredient"
                           Badge="@(!string.IsNullOrWhiteSpace(this._ingredient.Name.Input) ? this._ingredient.Name.Input : null)">

                <div class="accordion-step-body">
                    <SearchField class="mb-3"
                                 Label="Search existing ingredients or create a new one"
                                 Placeholder="Type to search ingredients..."
                                 Value="@this._ingredientSearchString"
                                 ValueChanged="this.SetIngredientSearchValue" />

                    <ListInput @ref="this._ingredientList"
                               TItem="IngredientViewModel"
                               Values="this._ingredientSearchResults"
                               AllowCreate="true"
                               CreateText="@this.CreateIngredientButtonText"
                               EmptyText="No matching ingredients found."
                               ItemText="ingredient => ingredient.Name ?? string.Empty"
                               OnCreateActivated="this.EnableCreateNewIngredient"
                               OnValueSelected="this.SelectExistingIngredient"
                               class="selector-scroll-list mb-3" />

                    @if (!this._ingredient.UsingExistingIngredient)
                    {
                        <div class="card p-3 mb-3 bg-light border">
                            <InputField Input="this._ingredient.Name"
                                        Title="New Ingredient Name" />
                        </div>
                    }
                </div>

            </AccordionItem>

            @* Accordion Section 2: Measurement *@
            <AccordionItem @ref="this._measurementSection"
                           Title="2. Measurement Type"
                           Badge="@this._ingredient.MeasurementModel?.Name"
                           Disabled="@(!this._ingredient.Name.IsValid())">

                <div class="accordion-step-body">
                    <SearchField class="mb-3"
                                 Label="Search measurement types (e.g., ml, oz, dash, tsp)"
                                 Placeholder="Type to search measurements..."
                                 Value="@this._measurementSearchString"
                                 ValueChanged="this.SetMeasurementSearchValue" />

                    <ListInput @ref="this._measurementList"
                               TItem="MeasurementViewModel"
                               Values="this._measurementSearchResults"
                               EmptyText="No matching measurements found."
                               ItemText="measurement => measurement.Name ?? string.Empty"
                               OnValueSelected="this.SelectMeasurement"
                               class="selector-scroll-list mb-3" />
                </div>

            </AccordionItem>

            @* Accordion Section 3: Amount *@
            <AccordionItem @ref="this._amountSection"
                           Title="3. Amount"
                           Badge="@(this._ingredient.Amount.Input > 0 ? this._ingredient.Amount.Input.ToString() : null)"
                           Disabled="@(this._ingredient.MeasurementModel is null)">

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Amount @(this._ingredient.MeasurementModel is not null ? $"({this._ingredient.MeasurementModel.Name})" : "")
                        </label>

                        <div class="input-group input-group-lg">
                            <input @bind-value="this._ingredient.Amount.Input"
                                   @bind-value:event="oninput"
                                   class="form-control"
                                   min="0.01"
                                   step="any"
                                   type="number"
                                   placeholder="e.g. 30" />

                            @if (this._ingredient.MeasurementModel is not null)
                            {
                                <span class="input-group-text">@this._ingredient.MeasurementModel.Name</span>
                            }
                        </div>

                        <div class="form-text mt-2 text-muted">
                            Enter the amount of @(string.IsNullOrWhiteSpace(this._ingredient.Name.Input) ? "ingredient" : this._ingredient.Name.Input) to add to the recipe.
                        </div>
                    </div>

            </AccordionItem>
        </Accordion>

        @* Ingredient Preview *@
        <div class="mt-3">
            <div class="text-secondary small text-uppercase fw-semibold mb-2">Preview</div>

            <div class="card p-3 bg-light border">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-medium">
                        @(string.IsNullOrWhiteSpace(this._ingredient.Name.Input) ? "Select an ingredient..." : this._ingredient.Name.Input)
                    </span>

                    <span class="text-secondary small">
                        @if (!string.IsNullOrWhiteSpace(this._ingredient.Name.Input) && this._ingredient.MeasurementModel is not null && this._ingredient.Amount.Input > 0)
                        {
                            <span>@this._ingredient.Amount.Input @this._ingredient.MeasurementModel.Name</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(this._ingredient.Name.Input) && this._ingredient.MeasurementModel is not null)
                        {
                            <span>@this._ingredient.Amount.Input @this._ingredient.MeasurementModel.Name</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(this._ingredient.Name.Input))
                        {
                            <span class="text-muted fst-italic">Select measurement & amount...</span>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Click to configure</span>
                        }
                    </span>
                </div>
            </div>
        </div>
    </Body>

    <Footer>
        <Button Text="Cancel"
                Theme="ButtonTheme.Secondary"
                data-bs-dismiss="modal" />

        <Button @onclick="this.OnClickAddAsync"
                Text="@(this.IsEditingExisting ? "Save" : "Add")"
                Theme="ButtonTheme.Success"
                data-bs-dismiss="modal"
                disabled="@(!this.IsAllCompleted())" />
    </Footer>

</Modal>

@code {
    private AccordionItem _amountSection = default!;
    private RecipeFormModelIngredient _ingredient = new();
    private ListInput<IngredientViewModel> _ingredientList = default!;
    private List<IngredientViewModel> _ingredientSearchResults = [];
    private string _ingredientSearchString = string.Empty;
    private AccordionItem _ingredientSection = default!;
    private ListInput<MeasurementViewModel> _measurementList = default!;
    private List<MeasurementViewModel> _measurementSearchResults = [];
    private string _measurementSearchString = string.Empty;
    private AccordionItem _measurementSection = default!;
    private Modal _modal = default!;
    private RecipeFormModelIngredient? _targetIngredient;

    private string CreateIngredientButtonText =>
        string.IsNullOrWhiteSpace(this._ingredientSearchString)
            ? "Create new ingredient..."
            : $"Create new ingredient: \"{this._ingredientSearchString}\"";

    [MemberNotNullWhen(true, nameof(_targetIngredient))]
    private bool IsEditingExisting => this._targetIngredient is not null;

    [Parameter]
    public EventCallback<RecipeFormModelIngredient> OnIngredientUpdated { get; set; }

    public async Task OpenModalAsync(RecipeFormModelIngredient? ingredient = null)
    {
        this._targetIngredient = ingredient;

        if (!this.IngredientsViewModel.Ingredients.Any())
            await this.IngredientsViewModel.GetCommand.ExecuteAsync(default);

        if (!this.MeasurementsViewModel.Measurements.Any())
            await this.MeasurementsViewModel.GetCommand.ExecuteAsync(default);

        this.InitializeWorkingCopy();
        await this._modal.OpenModalAsync();
    }

    private void InitializeWorkingCopy()
    {
        this._ingredientSection?.Open();

        this._ingredient = new RecipeFormModelIngredient();
        if (this._targetIngredient is not null)
            this._targetIngredient.CopyTo(this._ingredient);

        this._ingredient.Name.OnChange = this.StateHasChanged;

        this.SetIngredientSearchValue(string.Empty);
        this.SetMeasurementSearchValue(string.Empty);

        if (this._ingredient.UsingExistingIngredient && this._ingredient.ExistingIngredientId != Guid.Empty)
        {
            var _ExistingIngredient = this.IngredientsViewModel.Ingredients
                .FirstOrDefault(i => i.IngredientId == this._ingredient.ExistingIngredientId);
            this._ingredientList?.Select(_ExistingIngredient);
        }
        else if (!this._ingredient.UsingExistingIngredient && !string.IsNullOrWhiteSpace(this._ingredient.Name.Input))
            this._ingredientList?.SelectCreate();
        else
            this._ingredientList?.ClearSelection();

        if (this._ingredient.MeasurementModel is not null)
            this._measurementList?.Select(this._ingredient.MeasurementModel);
        else
            this._measurementList?.ClearSelection();
    }

    private void SelectExistingIngredient(IngredientViewModel ingredient)
    {
        this._ingredient.UsingExistingIngredient = true;
        this._ingredient.ExistingIngredientId = ingredient.IngredientId;
        this._ingredient.Name.Input = ingredient.Name ?? string.Empty;
        this._ingredient.MeasurementModel = null;
        this._ingredient.Measurement.ResetToDefault();
        this._measurementList?.ClearSelection();
        this.SetMeasurementSearchValue(string.Empty);

        if (ingredient.Measurements?.Count == 1)
        {
            var _SingleMeasurement = ingredient.Measurements.First();
            this._measurementList?.Select(_SingleMeasurement);
            this.SelectMeasurement(_SingleMeasurement);
        }
        else
            this._measurementSection.Open();
    }

    private void EnableCreateNewIngredient()
    {
        this._ingredient.UsingExistingIngredient = false;
        this._ingredient.ExistingIngredientId = Guid.Empty;

        if (!string.IsNullOrWhiteSpace(this._ingredientSearchString))
            this._ingredient.Name.Input = this._ingredientSearchString.Trim();

        this.SetMeasurementSearchValue(string.Empty);
        this._measurementList?.ClearSelection();
    }

    private void SelectMeasurement(MeasurementViewModel measurement)
    {
        this._ingredient.MeasurementModel = measurement;
        this._ingredient.Measurement.Input = measurement.MeasurementId;
        this._amountSection.Open();
    }

    private void SetIngredientSearchValue(string value)
    {
        this._ingredientSearchString = value ?? string.Empty;
        this._ingredientSearchResults = this.IngredientsViewModel.Ingredients
            .Where(ingredient => ingredient.Name is not null && ingredient.Name.Contains(this._ingredientSearchString, StringComparison.OrdinalIgnoreCase))
            .Take(15)
            .ToList();
    }

    private void SetMeasurementSearchValue(string value)
    {
        this._measurementSearchString = value ?? string.Empty;

        if (this._ingredient.UsingExistingIngredient && this._ingredient.ExistingIngredientId != Guid.Empty)
        {
            var selectedIngredient = this.IngredientsViewModel.Ingredients
                .FirstOrDefault(i => i.IngredientId == this._ingredient.ExistingIngredientId);

            this._measurementSearchResults = selectedIngredient?.Measurements?
                .Where(measurement => measurement.Name is not null && measurement.Name.Contains(this._measurementSearchString, StringComparison.OrdinalIgnoreCase))
                .ToList() ?? [];
        }
        else
        {
            this._measurementSearchResults = this.MeasurementsViewModel.Measurements
                .Where(measurement => measurement.Name is not null && measurement.Name.Contains(this._measurementSearchString, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private bool IsAllCompleted()
    {
        if (!this._ingredient.Name.IsValid())
            return false;

        if (this._ingredient.UsingExistingIngredient && this._ingredient.ExistingIngredientId == Guid.Empty)
            return false;

        if (this._ingredient.MeasurementModel is null || !this._ingredient.Measurement.IsValid())
            return false;

        if (!this._ingredient.Amount.IsValid())
            return false;

        return true;
    }

    private async Task OnClickAddAsync()
    {
        if (!this.IsAllCompleted())
            return;

        this._ingredient.Name.Input = this._ingredient.Name.Input.Trim();

        if (this.IsEditingExisting)
        {
            this._ingredient.CopyTo(this._targetIngredient);
            await this.OnIngredientUpdated.InvokeAsync(this._targetIngredient);
        }
        else
            await this.OnIngredientUpdated.InvokeAsync(this._ingredient);

        await this._modal.CloseModalAsync();
    }
}
