@using CocktailCollator.Web.FormModels.Users
@using CocktailCollator.Web.ViewModels.Users
@using CocktailCollator.Web.Views.Components.Buttons
@using CocktailCollator.Web.Views.Components.Inputs
@using CocktailCollator.Web.Views.Components.Modals
@using CocktailCollator.Web.Views.Components.Helpers
@using CocktailCollator.Web.ViewModels.Roles

@inject UpdateRolesFormModel FormModel
@inject UsersViewModel ViewModel
@inject RolesViewModel RolesViewModel

<Modal @ref="this._modal" 
       Title="Update Roles">

    <Body>
        <form>
            <h3>Update Roles</h3>

            <div class="mb-3">
                @foreach (var _Role in this.RolesViewModel.Roles)
                {
                    <div class="form-check">
                        <input @bind:get="this.FormModel.Roles.Input.Any(r => r.RoleId == _Role.RoleId)" 
                               @bind:set="value => this.OnRoleSelectionChanged(_Role, value)"
                               class="form-check-input"
                               id="role_@_Role.RoleId" 
                               type="checkbox" />

                        <label class="form-check-label" 
                               for="role_@_Role.RoleId">
                            @_Role.Name
                        </label>
                    </div>
                }
            </div>

            <FormChangeWrapper FormModel="this.FormModel">
                <Button @onclick="this.OnClickUpdateRoles"
                        Size="ButtonSize.Large"
                        Theme="ButtonTheme.Success"
                        Text="Save Roles"
                        class="mt-2"
                        data-bs-dismiss="modal" />
            </FormChangeWrapper>
        </form>
    </Body>

</Modal>

@code {
    private Modal _modal = default!;

    [Parameter]
    public EventCallback OnAfterChange { get; set; }

    private async Task OnClickUpdateRoles()
    {
        await this.ViewModel.UpdateRolesCommand.ExecuteAsync(this.FormModel.ExtractToInputPort());
        this.FormModel.ResetToDefault();
        await this.OnAfterChange.InvokeAsync();
    }

    private void OnRoleSelectionChanged(RoleViewModel role, bool isChecked)
    {
        if (isChecked)
        {
            if (!this.FormModel.Roles.Input.Any(r => r.RoleId == role.RoleId))
                this.FormModel.Roles.Input.Add(new UpdateRolesFormModelRole { RoleId = role.RoleId, Name = role.Name });
        }
        else
        {
            var _RoleToRemove = this.FormModel.Roles.Input.FirstOrDefault(r => r.RoleId == role.RoleId);
            if (_RoleToRemove is not null)
                this.FormModel.Roles.Input.Remove(_RoleToRemove);
        }
    }

    public Task OpenModalAsync(Guid userId, List<RoleViewModel> currentRoles)
    {
        this.FormModel.UserId = userId;
        this.FormModel.Roles.Input.Clear();
        foreach (var _Role in currentRoles)
            this.FormModel.Roles.Input.Add(new UpdateRolesFormModelRole { RoleId = _Role.RoleId, Name = _Role.Name });

        return this._modal.OpenModalAsync();
    }
}
