@using CocktailCollator.Web.FormModels.Users
@using CocktailCollator.Web.ViewModels.Users
@using CocktailCollator.Web.Views.Components.Buttons
@using CocktailCollator.Web.Views.Components.Inputs
@using CocktailCollator.Web.Views.Components.Modals
@using CocktailCollator.Web.Views.Components.Helpers
@using CocktailCollator.Web.ViewModels.Roles

@inject CreateUserFormModel CreateUserFormModel
@inject UsersViewModel ViewModel
@inject RolesViewModel RolesViewModel

<Modal @ref="this._modal"
       Title="Create User Account">

    <Body>
        <form>
            <h3>New User Account</h3>

            <InputField Input="this.CreateUserFormModel.Username"
                        InvalidMessage="Username requires a value."
                        Title="Username" />

            <InputField Input="this.CreateUserFormModel.Password"
                        Title="Password"
                        Type="password" />

            <div class="mb-3">
                <label class="form-label">Roles</label>
                @foreach (var _Role in this.RolesViewModel.Roles)
                {
                    <div class="form-check">
                        <input @bind:get="this.CreateUserFormModel.Roles.Input.Any(r => r.RoleId == _Role.RoleId)" 
                               @bind:set="value => this.OnRoleSelectionChanged(_Role, value)"
                               class="form-check-input"
                               id="create_role_@_Role.RoleId" 
                               type="checkbox" />

                        <label class="form-check-label" 
                               for="create_role_@_Role.RoleId">
                            @_Role.Name
                        </label>
                    </div>
                }
                @if (!this.CreateUserFormModel.Roles.IsValid())
                {
                    <div class="text-danger">A user must have at least one role assigned.</div>
                }
            </div>

            <FormChangeWrapper FormModel="this.CreateUserFormModel">
                <Button @onclick="this.OnClickCreate"
                        Size="ButtonSize.Large"
                        Theme="ButtonTheme.Success"
                        Text="Save"
                        class="mt-2"
                        data-bs-dismiss="modal"
                        disabled="@(!this.CreateUserFormModel.IsValid())" />
            </FormChangeWrapper>
        </form>
    </Body>

</Modal>

@code {
    private Modal _modal = default!;

    [Parameter]
    public EventCallback OnAfterCreation { get; set; }

    private async Task OnClickCreate()
    {
        await this.ViewModel.CreateCommand.ExecuteAsync(this.CreateUserFormModel.ExtractToInputPort());
        this.CreateUserFormModel.ResetToDefault();
        await this.OnAfterCreation.InvokeAsync();
    }

    private void OnRoleSelectionChanged(RoleViewModel role, bool isChecked)
    {
        if (isChecked)
        {
            if (!this.CreateUserFormModel.Roles.Input.Any(r => r.RoleId == role.RoleId))
                this.CreateUserFormModel.Roles.Input.Add(new CreateUserFormModelRole { RoleId = role.RoleId, Name = role.Name });
        }
        else
        {
            var _RoleToRemove = this.CreateUserFormModel.Roles.Input.FirstOrDefault(r => r.RoleId == role.RoleId);
            if (_RoleToRemove is not null)
                this.CreateUserFormModel.Roles.Input.Remove(_RoleToRemove);
        }
    }

    public Task OpenModalAsync()
    {
        var _DefaultRole = this.RolesViewModel.Roles.FirstOrDefault(r => r.IsDefaultRole);
        if (_DefaultRole is not null && this.CreateUserFormModel.Roles.Input.Count == 0)
            this.CreateUserFormModel.Roles.Input.Add(new CreateUserFormModelRole { RoleId = _DefaultRole.RoleId, Name = _DefaultRole.Name });
        
        return this._modal.OpenModalAsync();
    }

}
