@using CocktailCollator.Web.FormModels.Users
@using CocktailCollator.Web.ViewModels.Users
@using CocktailCollator.Web.Views.Components.Buttons
@using CocktailCollator.Web.Views.Components.Inputs
@using CocktailCollator.Web.Views.Components.Modals
@using CocktailCollator.Web.Views.Components.Helpers

@inject CreateUserFormModel CreateUserFormModel
@inject UsersViewModel ViewModel

<Modal @ref="this._modal"
       Title="Create User Account">

    <Body>
        <form>
            <h3>New User Account</h3>

            <InputField Input="this.CreateUserFormModel.Username"
                        InvalidMessage="Username requires a value."
                        Title="Username" />

            <InputField Input="this.CreateUserFormModel.Password"
                        Title="Password"
                        Type="password" />

            <FormChangeWrapper FormModel="this.CreateUserFormModel">
                <Button @onclick="this.OnClickCreate"
                        Size="ButtonSize.Large"
                        Theme="ButtonTheme.Success"
                        Text="Save"
                        class="mt-2"
                        data-bs-dismiss="modal"
                        disabled="@(!this.CreateUserFormModel.IsValid())" />
            </FormChangeWrapper>
        </form>
    </Body>

</Modal>

@code {
    private Modal _modal = default!;

    [Parameter]
    public EventCallback OnAfterCreation { get; set; }

    private async Task OnClickCreate()
    {
        await this.ViewModel.CreateCommand.ExecuteAsync(this.CreateUserFormModel.ExtractToInputPort());
        this.CreateUserFormModel.ResetToDefault();
        await this.OnAfterCreation.InvokeAsync();
    }

    public Task OpenModalAsync()
        => this._modal.OpenModalAsync();

}
