@using CocktailCollator.Web.FormModels.Recipes
@using CocktailCollator.Web.ViewModels.RecipeCategories
@using CocktailCollator.Web.ViewModels.Recipes
@using CocktailCollator.Web.Views.Components.Buttons
@using CocktailCollator.Web.Views.Components.Helpers
@using CocktailCollator.Web.Views.Components.Inputs
@using CocktailCollator.Web.Views.Components.Modals

@inject UpdateRecipeFormModel UpdateRecipeFormModel
@inject RecipesViewModel RecipesViewModel
@inject RecipeCategoriesViewModel RecipeCategoriesViewModel

<Modal @ref="this._modal"
       Size="ModalSize.Large"
       Title="Update Recipe">

    <Body>
        <form>
            <h3>Update Recipe</h3>

            <InputField Input="this.UpdateRecipeFormModel.Name"
                        InvalidMessage="Name requires a value."
                        Title="Recipe Name" />

            <label class="form-label">Category</label>
            <div class="input-group flex-nowrap">
                <input class="form-control flex-grow-1"
                       disabled
                       placeholder="Select a category..."
                       type="text"
                       value="@(this.UpdateRecipeFormModel.RecipeCategory.Input?.Name ?? "")" />

                <button @onclick="() => this.UpdateRecipeFormModel.RecipeCategory.Input = null"
                        class="btn btn-outline-danger"
                        type="button">
                    Clear
                </button>
                
                <button aria-expanded="false"
                        class="btn btn-outline-secondary dropdown-toggle dropdown-toggle-split flex-shrink-0"
                        data-bs-toggle="dropdown"
                        type="button">
                    <span class="visually-hidden">Toggle Dropdown</span>
                </button>

                <ul class="dropdown-menu">
                    <li>
                        <input @bind-value:event="oninput"
                               @bind-value:get="this._categorySearchString"
                               @bind-value:set="this.SetCategorySearchValue"
                               class="form-control mb-2"
                               placeholder="Type to search..."
                               type="text" />
                    </li>

                    @foreach (var category in this._categorySearchResults)
                    {
                        <li>
                            <span @onclick="() => this.UpdateRecipeFormModel.RecipeCategory.Input = category"
                                  class="dropdown-item">@category.Name</span>
                        </li>
                    }
                </ul>
            </div>

            <DocumentUpload @ref="this._documentUpload"
                            Accept="image/*"
                            Documents="this.UpdateRecipeFormModel.Images"
                            Multiple
                            Title="Images"
                            class="mb-3 mt-1" />

            <h4>Ingredients</h4>

            <Button @onclick="() => this.UpdateRecipeFormModel.Ingredients.Add(new())"
                    Theme="ButtonTheme.Primary"
                    Text="Add Ingredient" />

            <div>
                <ul class="list-group">
                    @foreach (var ingredient in this.UpdateRecipeFormModel.Ingredients)
                    {
                        <li class="list-group-item">
                            <UpdateRecipeIngredientSelector Ingredient="ingredient" />
                            <Button @onclick="() => this.UpdateRecipeFormModel.Ingredients.Remove(ingredient)"
                                    Size="ButtonSize.Small"
                                    Theme="ButtonTheme.Danger"
                                    Text="Remove"
                                    class="mt-2" />
                        </li>
                    }
                </ul>
            </div>

            <h4>Steps</h4>

            <Button @onclick="this.AddStep"
                    Theme="ButtonTheme.Primary"
                    Text="Add Step" />

            <div>
                <ul class="list-group">
                    @foreach (var step in this.UpdateRecipeFormModel.Steps)
                    {
                        <li class="list-group-item">
                            <InputField Input="step.Instruction"
                                        InvalidMessage="Instruction requires a value."
                                        Title="Step Instruction" />

                            <div class="btn-group">
                                <Button @onclick="() => this.MoveStepUp(step)"
                                        Size="ButtonSize.Small"
                                        Theme="ButtonTheme.Secondary"
                                        Text="▲"
                                        disabled="@(step.Order.Input <= 0)" />

                                <Button @onclick="() => this.MoveStepDown(step)"
                                        Size="ButtonSize.Small"
                                        Theme="ButtonTheme.Secondary"
                                        Text="▼"
                                        disabled="@(step.Order.Input >= this.UpdateRecipeFormModel.Steps.Count - 1)" />
                            </div>

                            <Button @onclick="() => this.RemoveStep(step)"
                                    Size="ButtonSize.Small"
                                    Theme="ButtonTheme.Danger"
                                    Text="Remove" />
                        </li>
                    }
                </ul> 
            </div>

            <h4 class="mt-4">Notes</h4>

            <div class="mb-3">
                <label class="form-label">Global Note</label>
                <textarea class="form-control" rows="3" placeholder="Add a note that everyone can see..."
                          @bind="this.UpdateRecipeFormModel.GlobalNote.Input"
                          @bind:event="oninput"></textarea>
            </div>

            <FormChangeWrapper FormModel="this.UpdateRecipeFormModel">
                <Button @onclick="this.OnClickUpdateAsync"
                        Size="ButtonSize.Large"
                        Theme="ButtonTheme.Success"
                        Text="Save Recipe"
                        class="mt-2"
                        data-bs-dismiss="modal"
                        disabled="@(!this.UpdateRecipeFormModel.IsValid())" />
            </FormChangeWrapper>
        </form>
    </Body>

</Modal>

@code {
    private List<RecipeCategoryViewModel> _categorySearchResults = [];
    private string _categorySearchString = "";
    private DocumentUpload _documentUpload = default!;
    private Modal _modal = default!;

    [Parameter]
    public EventCallback OnAfterUpdate { get; set; }

    private void AddStep()
    {
        var step = new UpdateRecipeFormModelStep();
        step.Order.Input = this.UpdateRecipeFormModel.Steps.Count;
        this.UpdateRecipeFormModel.Steps.Add(step);
    }

    private void MoveStepDown(UpdateRecipeFormModelStep step)
    {
        if (step.Order.Input >= this.UpdateRecipeFormModel.Steps.Count - 1)
            return;

        this.UpdateRecipeFormModel.Steps.Move(step, 1);
        this.RecalculateSteps();
    }

    private void MoveStepUp(UpdateRecipeFormModelStep step)
    {
        if (step.Order.Input <= 0)
            return;

        this.UpdateRecipeFormModel.Steps.Move(step, -1);
        this.RecalculateSteps();
    }

    private async Task OnClickUpdateAsync()
    {
        await this.RecipesViewModel.UpdateCommand.ExecuteAsync(this.UpdateRecipeFormModel.ExtractToInputPort());
        this._documentUpload.Reset();
        this.UpdateRecipeFormModel.ResetToDefault();
        await this.OnAfterUpdate.InvokeAsync();
    }

    public async Task OpenModalAsync(RecipeViewModel recipe)
    {
        this.UpdateRecipeFormModel.RecipeId.Input = recipe.RecipeId;
        this.UpdateRecipeFormModel.Name.Input = recipe.Name ?? string.Empty;
        this.UpdateRecipeFormModel.RecipeCategory.Input = recipe.Category;
        this.UpdateRecipeFormModel.GlobalNote.Input = recipe.GlobalNote;

        this.UpdateRecipeFormModel.Images.ResetToDefault();
        this.UpdateRecipeFormModel.Images.AddRange(recipe.Images?.Select(i => i.AsExistingDocument()) ?? []);

        this.UpdateRecipeFormModel.Ingredients.Clear();
        foreach (var ingredient in recipe.Ingredients ?? [])
        {
            var newIngredient = new UpdateRecipeFormModelIngredient();
            newIngredient.Amount.Input = ingredient.Amount ?? 0;
            newIngredient.ExistingIngredientId = ingredient.IngredientId;
            newIngredient.Name.Input = ingredient.Ingredient?.Name ?? "";
            newIngredient.Measurement.Input = ingredient.MeasurementId;
            newIngredient.MeasurementModel = ingredient.Measurement;
            this.UpdateRecipeFormModel.Ingredients.Add(newIngredient);
        }

        this.UpdateRecipeFormModel.Steps.Clear();
        foreach (var step in recipe.Steps ?? [])
        {
            var newStep = new UpdateRecipeFormModelStep();
            newStep.Instruction.Input = step.Instruction ?? "";
            newStep.Order.Input = step.Order ?? 0;
            this.UpdateRecipeFormModel.Steps.Add(newStep);
        }

        await this.RecipeCategoriesViewModel.GetCommand.ExecuteAsync(default);

        await this._modal.OpenModalAsync();
    }

    private void RecalculateSteps()
    {
        for (int i = 0; i < this.UpdateRecipeFormModel.Steps.Count; i++)
            this.UpdateRecipeFormModel.Steps[i].Order.Input = i;
    }

    private void RemoveStep(UpdateRecipeFormModelStep stepIndex)
    {
        _ = this.UpdateRecipeFormModel.Steps.Remove(stepIndex);
        this.RecalculateSteps();
    }

    private void SetCategorySearchValue(string? value)
    {
        this._categorySearchString = value ?? "";
        this._categorySearchResults = this.RecipeCategoriesViewModel.RecipeCategories
            .Where(category => category.Name is not null && category.Name.Contains(this._categorySearchString, StringComparison.OrdinalIgnoreCase))
            .Take(5)
            .ToList();
    }
}
