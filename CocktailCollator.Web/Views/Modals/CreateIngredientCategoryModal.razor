@using CocktailCollator.Web.FormModels.IngredientCategories
@using CocktailCollator.Web.ViewModels.IngredientCategories
@using CocktailCollator.Web.Views.Components.Buttons
@using CocktailCollator.Web.Views.Components.Inputs
@using CocktailCollator.Web.Views.Components.Modals

@inject CreateIngredientCategoryFormModel CreateIngredientCategoryFormModel
@inject IngredientCategoriesViewModel ViewModel

<Modal @ref="this._modal"
       Title="Create Ingredient Category">

    <Body>
        <form>
            <h3>New Ingredient Category</h3>

            <InputField Input="this.CreateIngredientCategoryFormModel.Name"
                        InvalidMessage="Name requires a value."
                        Title="Category Name" />

            <Button @onclick="this.OnClickCreate"
                    Size="ButtonSize.Large"
                    Theme="ButtonTheme.Success"
                    Text="Save"
                    class="mt-2"
                    data-bs-dismiss="modal"
                    disabled="@(!this.CreateIngredientCategoryFormModel.IsValid())" />
        </form>
    </Body>

</Modal>

@code {
    private Modal _modal = default!;

    [Parameter]
    public EventCallback OnAfterCreation { get; set; }

    private async Task OnClickCreate()
    {
        await this.ViewModel.CreateCommand.ExecuteAsync(this.CreateIngredientCategoryFormModel.ExtractToInputPort());
        this.CreateIngredientCategoryFormModel.ResetToDefault();
        await this.OnAfterCreation.InvokeAsync();
    }

    protected override void OnInitialized()
        => this.CreateIngredientCategoryFormModel.OnChange = this.StateHasChanged;

    public Task OpenModalAsync()
        => this._modal.OpenModalAsync();
}
