@using CocktailCollator.Web.FormModels.Users
@using CocktailCollator.Web.ViewModels.Users
@using CocktailCollator.Web.Views.Components.Buttons
@using CocktailCollator.Web.Views.Components.Inputs
@using CocktailCollator.Web.Views.Components.Modals
@using CocktailCollator.Web.Views.Components.Helpers
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options

@inject IOptions<IdentityOptions> IdentityOptions
@inject ChangePasswordFormModel ChangePasswordFormModel
@inject UsersViewModel ViewModel

<Modal @ref="this._modal"
       Title="Change Password">

    <Body>
        <form>
            <h3>Change Password</h3>

            <InputField Input="this.ChangePasswordFormModel.NewPassword"
                        InvalidMessage="@this.PasswordInvalidMessage"
                        Title="New Password"
                        Type="password" />

            <FormChangeWrapper FormModel="this.ChangePasswordFormModel">
                <Button @onclick="this.OnClickChangePassword"
                        Size="ButtonSize.Large"
                        Theme="ButtonTheme.Success"
                        Text="Change Password"
                        class="mt-2"
                        data-bs-dismiss="modal"
                        disabled="@(!this.ChangePasswordFormModel.IsValid())" />
            </FormChangeWrapper>
        </form>
    </Body>

</Modal>

@code {
    private Modal _modal = default!;

    [Parameter]
    public EventCallback OnAfterChange { get; set; }

    public string PasswordInvalidMessage
    {
        get
        {
            var options = this.IdentityOptions.Value.Password;
            var requirements = new List<string>();
            
            if (options.RequiredLength > 0) 
                requirements.Add($"{options.RequiredLength} characters long");
                
            var contains = new List<string>();
            if (options.RequireLowercase) contains.Add("a lowercase letter");
            if (options.RequireUppercase) contains.Add("an uppercase letter");
            if (options.RequireDigit) contains.Add("a number");
            if (options.RequireNonAlphanumeric) contains.Add("a special character");
            
            if (contains.Any())
            {
                var containsStr = contains.Count > 1 
                    ? string.Join(", ", contains.Take(contains.Count - 1)) + " and " + contains.Last()
                    : contains.First();
                requirements.Add($"contain {containsStr}");
            }
            
            if (!requirements.Any()) return "Password requires a value.";
            
            return $"Password must be {string.Join(", and ", requirements)}.";
        }
    }

    private async Task OnClickChangePassword()
    {
        await this.ViewModel.ChangePasswordCommand.ExecuteAsync(this.ChangePasswordFormModel.ExtractToInputPort());
        this.ChangePasswordFormModel.ResetToDefault();
        await this.OnAfterChange.InvokeAsync();
    }

    public Task OpenModalAsync(Guid userId)
    {
        this.ChangePasswordFormModel.UserId = userId;
        return this._modal.OpenModalAsync();
    }
}
