@using CocktailCollator.Web.FormModels.RecipeCategories
@using CocktailCollator.Web.ViewModels.RecipeCategories
@using CocktailCollator.Web.Views.Components.Buttons
@using CocktailCollator.Web.Views.Components.Inputs
@using CocktailCollator.Web.Views.Components.Modals

@inject RecipeCategoriesViewModel ViewModel
@inject UpdateRecipeCategoryFormModel UpdateRecipeCategoryFormModel

<Modal @ref=this._modal
       Size="ModalSize.Large"
       Title="Update Recipe Category">

    <Body>
        <InputField Input="this.UpdateRecipeCategoryFormModel.Name"
                    InvalidMessage="Name requires a value."
                    Title="Name" />
    </Body>

    <Footer>
        <Button @onclick="this.CloseModalAsync"
                Text="Cancel"
                Theme="ButtonTheme.Secondary" />

        <Button @onclick="this.UpdateRecipeCategoryAsync"
                Disabled="!this.UpdateRecipeCategoryFormModel.IsValid()"
                Text="Update"
                Theme="ButtonTheme.Primary" />
    </Footer>

</Modal>

@code {
    private Modal _modal = default!;

    protected override void OnInitialized()
    {
        this.UpdateRecipeCategoryFormModel.OnChange += this.StateHasChanged;
    }

    public async Task OpenModalAsync(RecipeCategoryViewModel recipeCategory)
    {
        this.UpdateRecipeCategoryFormModel.ResetToDefault();
        this.UpdateRecipeCategoryFormModel.RecipeCategoryId.Input = recipeCategory.RecipeCategoryId;
        this.UpdateRecipeCategoryFormModel.Name.Input = recipeCategory.Name;

        await this._modal.OpenModalAsync();
    }

    public async Task CloseModalAsync()
    {
        await this._modal.CloseModalAsync();
    }

    private async Task UpdateRecipeCategoryAsync()
    {
        if (this.UpdateRecipeCategoryFormModel.IsValid())
        {
            await this.ViewModel.UpdateCommand.ExecuteAsync(this.UpdateRecipeCategoryFormModel.ExtractToInputPort());
            await this.CloseModalAsync();
        }
    }
}
