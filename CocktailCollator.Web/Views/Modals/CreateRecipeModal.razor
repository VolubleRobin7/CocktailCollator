@using CocktailCollator.Web.FormModels.Recipes
@using CocktailCollator.Web.ViewModels.Recipes
@using CocktailCollator.Web.Views.Components.Buttons
@using CocktailCollator.Web.Views.Components.Helpers
@using CocktailCollator.Web.Views.Components.Inputs
@using CocktailCollator.Web.Views.Components.Modals

@inject CreateRecipeFormModel CreateRecipeFormModel
@inject RecipesViewModel RecipesViewModel

<Modal @ref=this._modal
       Size="ModalSize.Large"
       Title="Create Recipe">

    <Body>
        <form>
            <h3>New Recipe</h3>

            <InputField Input="this.CreateRecipeFormModel.Name"
                        InvalidMessage="Name requires a value."
                        Title="Recipe Name" />

            <DocumentUpload @ref="this._documentUpload"
                            Accept="image/*"
                            Documents="this.CreateRecipeFormModel.Images"
                            Multiple="true"
                            Title="Recipe Images"
                            class="mb-3" />

            <h4>Ingredients</h4>

            <Button @onclick="() => this.CreateRecipeFormModel.Ingredients.Input.Add(new())"
                    Theme="ButtonTheme.Primary"
                    Text="Add Ingredient" />

            <div>
                <ul class="list-group">
                    @foreach (var ingredient in this.CreateRecipeFormModel.Ingredients.Input)
                    {
                        <li class="list-group-item">
                            <CreateRecipeIngredientSelector Ingredient="ingredient" />
                            <Button @onclick="() => this.CreateRecipeFormModel.Ingredients.Input.Remove(ingredient)"
                                    Size="ButtonSize.Small"
                                    Theme="ButtonTheme.Danger"
                                    Text="Remove"
                                    class="mt-2" />
                        </li>
                    }
                </ul>
            </div>

            <h4>Steps</h4>

            <Button @onclick="this.AddStep"
                    Theme="ButtonTheme.Primary"
                    Text="Add Step" />

            <div>
                <ul class="list-group">
                    @foreach (var step in this.CreateRecipeFormModel.Steps.Select(input => input.Input))
                    {
                        <li class="list-group-item">
                            <InputField Input="step.Instruction"
                                        InvalidMessage="Instruction requires a value."
                                        Title="Step Instruction" />

                            <div class="btn-group">
                                <Button @onclick="() => this.MoveStepUp(step)" 
                                        Size="ButtonSize.Small"
                                        Text="▲"
                                        Theme="ButtonTheme.Secondary"
                                        disabled="@(step.Order.Input <= 0)" />

                                <Button @onclick="() => this.MoveStepDown(step)"
                                        Size="ButtonSize.Small"
                                        Text="▼"
                                        Theme="ButtonTheme.Secondary"
                                        disabled="@(step.Order.Input >= this.CreateRecipeFormModel.Steps.Count - 1)" />
                            </div>

                            <Button @onclick="() => this.RemoveStep(step)"
                                    Size="ButtonSize.Small"
                                    Theme="ButtonTheme.Danger"
                                    Text="Remove" />
                        </li>
                    }
                </ul>
            </div>

            <FormChangeWrapper FormModel="this.CreateRecipeFormModel">
                <Button @onclick="this.OnClickCreateAsync"
                        Size="ButtonSize.Large"
                        Theme="ButtonTheme.Success"
                        Text="Save Recipe"
                        class="mt-2"
                        data-bs-dismiss="modal"
                        disabled="@(!this.CreateRecipeFormModel.IsValid())" />
            </FormChangeWrapper>
        </form>
    </Body>

</Modal>

@code {
    private DocumentUpload _documentUpload = default!;
    private Modal _modal = default!;

    [Parameter]
    public EventCallback OnAfterCreation { get; set; }

    private void AddStep()
    {
        var step = new CreateRecipeFormModelStep();
        step.Order.Input = this.CreateRecipeFormModel.Steps.Count;
        this.CreateRecipeFormModel.Steps.Add(step);
    }

    private void MoveStepDown(CreateRecipeFormModelStep step)
    {
        if (step.Order.Input >= this.CreateRecipeFormModel.Steps.Count - 1)
            return;

        var stepIndex = this.CreateRecipeFormModel.Steps.IndexOf(step);
        this.CreateRecipeFormModel.Steps.Move(stepIndex, stepIndex + 1);
        this.RecalculateSteps();
    }

    private void MoveStepUp(CreateRecipeFormModelStep step)
    {
        if (step.Order.Input <= 0)
            return;

        var stepIndex = this.CreateRecipeFormModel.Steps.IndexOf(step);
        this.CreateRecipeFormModel.Steps.Move(stepIndex, stepIndex - 1);
        this.RecalculateSteps();
    }

    private async Task OnClickCreateAsync()
    {
        await this.RecipesViewModel.CreateCommand.ExecuteAsync(this.CreateRecipeFormModel.ExtractToInputPort());
        this.CreateRecipeFormModel.ResetToDefault();
        this._documentUpload.Reset();
        await this.OnAfterCreation.InvokeAsync();
    }

    public Task OpenModalAsync()
        => this._modal.OpenModalAsync();

    private void RecalculateSteps()
    {
        for (int i = 0; i < this.CreateRecipeFormModel.Steps.Count; i++)
            this.CreateRecipeFormModel.Steps[i].Input.Order.Input = i;
    }

    private void RemoveStep(CreateRecipeFormModelStep stepIndex)
    {
        _ = this.CreateRecipeFormModel.Steps.Remove(stepIndex);
        this.RecalculateSteps();
    }

}
