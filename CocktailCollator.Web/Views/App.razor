@using Pages.Static

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="css/bootstrap.min.css" />
    <link rel="stylesheet" href="css/app.css" />
    <link rel="stylesheet" href="CocktailCollator.Web.styles.css" />
    <HeadOutlet @rendermode="this.PageRenderMode()" />
</head>

<body>
    <Routes @rendermode="this.PageRenderMode()" />
    <script src="js/bootstrap.bundle.min.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode()
        => StaticPages.Routes.Any(route => HttpContext.Request.Path.StartsWithSegments(route))
            ? null
            : InteractiveServer;
}
