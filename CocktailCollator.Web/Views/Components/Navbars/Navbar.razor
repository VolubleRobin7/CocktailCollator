@inject NavigationManager NavigationManager

<nav class="navbar navbar-expand-lg bg-body-secondary">
    <div class="container">
        <a class="navbar-brand"
           href="/">
            Cocktail Collator
        </a>

        <button aria-controls="navbarLinks"
                aria-expanded="false"
                aria-label="Toggle navigation"
                class="navbar-toggler"
                data-bs-toggle="collapse"
                data-bs-target="#navbarLinks"
                type="button">

            <span class="navbar-toggler-icon"></span>

        </button>

        <div class="collapse navbar-collapse"
             id="navbarLinks">

            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link @(this.IsPageActive(NavbarAddress.Recipes) ? "active" : "")"
                       href="/">
                        Recipes
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(this.IsPageActive(NavbarAddress.Ingredients) ? "active" : "")"
                       href="/ingredients">
                        Ingredients
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(this.IsPageActive(NavbarAddress.Measurements) ? "active" : "")"
                       href="/measurements">
                        Measurements
                    </a>
                </li>
            </ul>

        </div>
    </div>
</nav>

@code {
    private NavbarAddress _currentPage = NavbarAddress.Recipes;

    private bool IsPageActive(NavbarAddress page)
        => page.RelativeUri == this._currentPage.RelativeUri;

    private void LocationChanged(object? sender, LocationChangedEventArgs args)
    {
        this._currentPage = this.UriStringToAddress(args.Location);
        this.StateHasChanged();
    }

    public void NavigateTo(NavbarAddress address)
        => this.NavigationManager.NavigateTo(address.RelativeUri);

    protected override void OnInitialized()
    {
        this._currentPage = this.UriStringToAddress(this.NavigationManager.Uri);
        this.NavigationManager.LocationChanged += this.LocationChanged;
    }

    private NavbarAddress UriStringToAddress(string uri)
    {
        var _RelativeUri = this.NavigationManager.ToBaseRelativePath(uri);
        var _PageUri = _RelativeUri.Split('/', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();

        if (_PageUri == NavbarAddress.Recipes.RelativeUri)
            return NavbarAddress.Recipes;
        else if (_PageUri == NavbarAddress.Ingredients.RelativeUri)
            return NavbarAddress.Ingredients;
        else if (_PageUri == NavbarAddress.Measurements.RelativeUri)
            return NavbarAddress.Measurements;

        return NavbarAddress.Recipes;
    }
}
