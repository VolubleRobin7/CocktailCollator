<nav class="navbar navbar-expand-lg bg-body-secondary">
    <div class="container">
        <a class="navbar-brand"
           href="/">
            Cocktail Collator
        </a>

        <button aria-controls="navbarLinks"
                aria-expanded="false"
                aria-label="Toggle navigation"
                class="navbar-toggler"
                data-bs-toggle="collapse"
                data-bs-target="#navbarLinks"
                type="button">

            <span class="navbar-toggler-icon"></span>

        </button>

        <div class="collapse navbar-collapse"
             id="navbarLinks">

            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link @(this.IsPageActive("recipe") ? "active" : "")"
                       href="/">
                        Recipes
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(this.IsPageActive("ingredients") ? "active" : "")"
                       href="/ingredients">
                        Ingredients
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(this.IsPageActive("something") ? "active" : "")"
                       href="/something">
                        Something
                    </a>
                </li>
            </ul>

        </div>
    </div>
</nav>

@code {

    [Parameter]
    public string CurrentPage { get; set; } = "";

    private bool IsPageActive(string page)
        => page == this.CurrentPage;

}
