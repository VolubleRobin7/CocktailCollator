@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<header class="text-center pt-3 pb-3 position-relative container">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
        <div>
            <button @onclick="ToggleNavMenu"
                    class="menu-toggler d-md-none border"
                    type="button">

                @* Burger menu icon *@
                <svg fill="#2c2a26"
                     height="24"
                     viewBox="0 0 100 80"
                     width="24">
                    <rect height="10"
                          rx="5"
                          width="100"></rect>
                    <rect height="10"
                          rx="5"
                          width="100"
                          y="30"></rect>
                    <rect height="10"
                          rx="5"
                          width="100"
                          y="60"></rect>
                </svg>

                <span class="ms-2">MENU</span>
            </button>
        </div>
        
        <div class="menu-top-right small text-end ms-auto">
            <AuthorizeView>
                <Authorized>
                    <div class="dropdown d-inline-block">
                        <a aria-expanded="false"
                           class="dropdown-toggle"
                           data-bs-toggle="dropdown"
                           href="#"
                           id="userDropdown"
                           role="button">
                            @(context.User.Identity?.Name ?? "Account") | Log Out
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <NavLink Match="NavLinkMatch.All"
                                         class="dropdown-item"
                                         href="users">
                                    Users Management
                                </NavLink>
                            </li>

                            <li>
                                <hr class="dropdown-divider">
                            </li>

                            <li>
                                <a @onclick="@(() => this.NavigationManager.NavigateTo("/logout", forceLoad: true))"
                                   class="dropdown-item"
                                   role="button">
                                    Confirm Log Out
                                </a>
                            </li>
                        </ul>
                    </div>
                </Authorized>

                <NotAuthorized>
                    <a @onclick="@(() => this.NavigationManager.NavigateTo("/login", forceLoad: true))"
                       role="button">
                        Log In
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>

    <h1 class="display-4 fw-bold mb-1">Cocktail Collator</h1>
    <div class="menu-subtitle small text-uppercase text-secondary">add a phrase here</div>

    <div class="text-center">
        <div class="collapse d-md-block mt-4 @(this._isNavMenuCollapsed ? "" : "show")"
             id="menuLinks">

            <ul class="d-flex flex-column flex-md-row justify-content-center gap-3 gap-md-4 mb-4 mb-md-5 pt-3 pt-md-0 list-unstyled px-0">
                @foreach (var _Page in this.Pages)
                {
                    @if (_Page.Policy is null)
                    {
                        <NavBarLink Page="@_Page" />
                    }
                    else
                    {
                        <AuthorizeView Policy="@_Page.Policy">
                            <NavBarLink Page="@_Page" />
                        </AuthorizeView>
                    }
                }
            </ul>

        </div>
    </div>
</header>

@code {
    private NavbarAddress _currentPage = NavbarAddress.Recipes;
    private bool _isNavMenuCollapsed = true;
    private bool _isUserAuthenticated = false;

    [Parameter]
    public NavbarAddress[] Pages { get; set; } = [];

    private void LocationChanged(object? sender, LocationChangedEventArgs args)
    {
        this._currentPage = this.UriStringToAddress(args.Location);
        this._isNavMenuCollapsed = true;
        this.StateHasChanged();
    }

    public void NavigateTo(NavbarAddress address)
        => this.NavigationManager.NavigateTo(address.RelativeUri);

    protected override async Task OnInitializedAsync()
    {
        this._currentPage = this.UriStringToAddress(this.NavigationManager.Uri);
        this.NavigationManager.LocationChanged += this.LocationChanged;

        var authState = await this.AuthenticationStateProvider.GetAuthenticationStateAsync();
        this._isUserAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
        this.AuthenticationStateProvider.AuthenticationStateChanged += async (authState) => 
        {
            this._isUserAuthenticated = (await authState).User.Identity?.IsAuthenticated ?? false;
            await this.InvokeAsync(this.StateHasChanged);
        };
    }

    private void ToggleNavMenu()
        => this._isNavMenuCollapsed = !this._isNavMenuCollapsed;

    private NavbarAddress UriStringToAddress(string uri)
    {
        var _RelativeUri = this.NavigationManager.ToBaseRelativePath(uri);
        var _PageUri = _RelativeUri.Split('/', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();

        if (_PageUri == NavbarAddress.Recipes.RelativeUri)
            return NavbarAddress.Recipes;
        else if (_PageUri == NavbarAddress.Ingredients.RelativeUri)
            return NavbarAddress.Ingredients;
        else if (_PageUri == NavbarAddress.Measurements.RelativeUri)
            return NavbarAddress.Measurements;

        return NavbarAddress.Recipes;
    }
}
