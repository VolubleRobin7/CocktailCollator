<div @attributes="this.AdditionalAttributes">
    @if (!string.IsNullOrWhiteSpace(this.Label))
    {
        <label class="form-label text-muted small">@this.Label</label>
    }

    <div class="input-group">
        <input @bind-value:event="oninput"
               @bind-value:get="this.Value"
               @bind-value:set="this.OnInputChangedAsync"
               class="form-control shadow-none"
               disabled="@this.Disabled"
               placeholder="@this.Placeholder"
               type="text" />

        @if (!this.HideClearButton && !string.IsNullOrEmpty(this.Value))
        {
            <button @onclick="this.ClearSearchAsync" 
                    class="btn btn-outline-secondary"
                    disabled="@this.Disabled"
                    type="button">
                ✕
            </button>
        }
    </div>
</div>

@code {
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool HideClearButton { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "Type to search...";

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    private async Task OnInputChangedAsync(string? newValue)
    {
        var _NewSearchValue = newValue ?? string.Empty;
        this.Value = _NewSearchValue;
        await this.ValueChanged.InvokeAsync(_NewSearchValue);
    }

    private async Task ClearSearchAsync()
    {
        await this.OnInputChangedAsync(string.Empty);
    }
}
