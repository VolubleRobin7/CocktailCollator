@using CocktailCollator.Web.Common.Inputs

<div @attributes="this.AdditionalAttributes">
    @if (!string.IsNullOrWhiteSpace(this.Title))
    {
        <label class="form-label">@this.Title</label>
    }
    <input @bind-value="this.Input.Input"
           @bind-value:event="@(this.UpdateOnlyOnFocusLoss ? "onchange" : "oninput")"
           class="form-control @(this.Input.IsValid() ? "is-valid" : "is-invalid")"
           type="@this.Type" />
    <div class="form-text">@this.Subtext</div>
    @if (this.ValidMessage is not null)
    {
        <div class="valid-feedback">@this.ValidMessage</div>
    }
    <div class="invalid-feedback">
        @(this.InvalidMessage is null ? this.Input.ErrorMessage : this.InvalidMessage)
    </div>
</div>

@code {
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    [EditorRequired]
    [Parameter]
    public InputProperty<string> Input { get; set; }

    /// <summary>
    /// Set a custom invalid message that overrides the error message from the InputProperty.
    /// </summary>
    [Parameter]
    public string? InvalidMessage { get; set; }

    [Parameter]
    public string Subtext { get; set; } = "";

    /// <summary>
    /// Set a title to display above the input field. If not set, no title will be displayed.
    /// </summary>
    /// <remarks>
    /// A title should be used if the input field is not self-explanatory.
    /// </remarks>
    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string Type { get; set; } = "text";

    [Parameter]
    public bool UpdateOnlyOnFocusLoss { get; set; }

    [Parameter]
    public string? ValidMessage { get; set; } = null;
}
