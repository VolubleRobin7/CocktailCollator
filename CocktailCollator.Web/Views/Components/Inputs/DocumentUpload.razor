@using CocktailCollator.Web.Common.Generics
@using CocktailCollator.Web.Views.Components.Buttons

<div @attributes="this.AdditionalAttributes">
    @if (!string.IsNullOrWhiteSpace(this.Title))
    {
        <label class="form-label">@this.Title</label>
    }
    
    @if (this.GetAllDocuments().Any(d => d.ExistingDocumentId.HasValue && d.Input is null))
    {
        <div class="mb-3">
            <ul class="list-group">
                @foreach (var document in this.GetAllDocuments().Where(d => d.ExistingDocumentId.HasValue && d.Input is null))
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            @if (!string.IsNullOrWhiteSpace(document.ExistingDocumentUrl))
                            {
                                <img alt="Document Image" 
                                     class="me-2 rounded existing-image" 
                                     src="@document.ExistingDocumentUrl" />
                            }

                            @* This should be the name of the document, once it is passed back from the back-end *@
                            <span>@(string.IsNullOrWhiteSpace(document.ExistingDocumentUrl) ? "Document" : "Image")</span>
                        </div>

                        <Button @onclick="() => this.RemoveDocument(document)"
                                Size="ButtonSize.Small"
                                Text="Remove"
                                Theme="ButtonTheme.Danger" />
                    </li>
                }
            </ul>
        </div>
    }

    <InputFile @key="this._inputFileKey"
               OnChange="this.UploadFileAsync"
               accept="@this.Accept"
               multiple="@this.Multiple"
               class="form-control" />

    @foreach (var document in this.GetAllDocuments().Where(d => !d.IsValid()))
    {
        <div class="text-danger mt-1 small">@document.ErrorMessage</div>
    }
</div>

@code {
    private Guid _inputFileKey = Guid.NewGuid();

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public string Accept { get; set; } = "*/*";

    [Parameter]
    public DocumentInputProperty? Document { get; set; }

    [Parameter]
    public ICollection<DocumentInputProperty>? Documents { get; set; }

    [Parameter]
    public bool Multiple { get; set; } = false;

    [Parameter]
    public EventCallback<InputFileChangeEventArgs> OnFileUploaded { get; set; }

    [Parameter]
    public string? Title { get; set; }

    private IEnumerable<DocumentInputProperty> GetAllDocuments()
    {
        if (this.Multiple && this.Documents is not null)
            return this.Documents;
        
        if (!this.Multiple && this.Document is not null)
            return [this.Document];

        return [];
    }

    public void Reset()
    {
        this._inputFileKey = Guid.NewGuid();
        this.StateHasChanged();
    }

    private void RemoveDocument(DocumentInputProperty document)
    {
        if (this.Multiple && this.Documents is not null)
            this.Documents.Remove(document);
        else if (!this.Multiple && this.Document == document)
        {
            this.Document.ExistingDocumentId = null;
            this.Document.ExistingDocumentUrl = null;
            this.Document.ResetToDefault();
        }
    }

    private async Task UploadFileAsync(InputFileChangeEventArgs args)
    {
        if (this.Multiple && this.Documents is not null)
        {
            var _ExistingDocuments = this.Documents.Where(d => d.ExistingDocumentId.HasValue).ToList(); // Must be a list so that they are not lost in the clear.
            this.Documents.Clear();
            foreach (var _Document in _ExistingDocuments)
                this.Documents.Add(_Document);

            var _UploadTasks = new List<Task>();
            foreach (var _File in args.GetMultipleFiles())
            {
                var _DocumentInput = new DocumentInputProperty();
                _DocumentInput.Input = _File;
                this.Documents.Add(_DocumentInput);
                _UploadTasks.Add(_DocumentInput.UploadFileAsync());
            }
            await Task.WhenAll(_UploadTasks);
        }
        else if (!this.Multiple && this.Document is not null)
        {
            this.Document.Input = args.File;
            await this.Document.UploadFileAsync();
        }

        await this.OnFileUploaded.InvokeAsync(args);
    }
}
