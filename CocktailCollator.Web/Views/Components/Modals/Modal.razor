@inject IJSRuntime JsRuntime

<div aria-hidden="true"
     aria-labelledby="@this._LabelId"
     class="modal fade" 
     data-bs-backdrop="@(this.IsLocked ? "static" : " ")"
     data-bs-keyboard="@(this.IsLocked ? "false" : "true")"
     id="@this._ModalId"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered @this.Size.CssClass">
        <div class="modal-content position-relative">

            <button aria-label="Close"
                    class="btn-close position-absolute top-0 end-0 mt-3 me-3"
                    data-bs-dismiss="modal"
                    type="button" />

            @if (!string.IsNullOrWhiteSpace(this.Title))
            {
                <div class="modal-header pe-5">
                    <h3 class="modal-title"
                        id="@this._LabelId">
                        @this.Title
                    </h3>
                </div>
            }

            <div class="modal-body">
                @this.Body
            </div>

            @if (this.Footer is not null)
            {
                <div class="modal-footer">
                    @this.Footer
                </div>
            }
        </div>
    </div>

</div>

@code {
    private IJSObjectReference _JsModule = default!;
    private readonly string _LabelId = $"modalLabel_{Guid.NewGuid()}";
    private readonly string _ModalId = $"modal_{Guid.NewGuid()}";

    public string Id => $"#{this._ModalId}";

    [EditorRequired, Parameter]
    public RenderFragment Body { get; set; }

    [Parameter]
    public RenderFragment? Footer { get; set; }

    [Parameter]
    public bool IsLocked { get; set; }

    [Parameter]
    public ModalSize Size { get; set; } = ModalSize.Medium;

    [Parameter]
    public string? Title { get; set; }

    public async Task CloseModalAsync()
        => await this._JsModule.InvokeVoidAsync("closeModal", this._ModalId);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
            this._JsModule = await this.JsRuntime.InvokeAsync<IJSObjectReference>("import", "./Views/Components/Modals/Modal.razor.js");
    }

    public async Task OpenModalAsync()
        => await this._JsModule.InvokeVoidAsync("openModal", this._ModalId);
}
