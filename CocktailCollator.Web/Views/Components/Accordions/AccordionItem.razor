@implements IDisposable

<div @attributes="this.AdditionalAttributes" 
     class="accordion-item">

    <h2 class="accordion-header" 
        id="@this._headerId">

        <button @onclick="this.OnClickHeader" 
                class="accordion-button @(this.IsOpen ? "" : "collapsed")"
                disabled="@this.Disabled"
                type="button">

            <div class="d-flex justify-content-between align-items-center w-100 me-3">
                <span class="fw-semibold">@this.Title</span>

                @if (!string.IsNullOrWhiteSpace(this.Badge))
                {
                    <span class="badge bg-primary">@this.Badge</span>
                }
            </div>

        </button>

    </h2>

    <div class="accordion-collapse collapse @(this.IsOpen ? "show" : "")"
         aria-labelledby="@this._headerId">

        <div class="accordion-body">
            @this.ChildContent
        </div>

    </div>

</div>

@code {
    private readonly string _headerId = $"accordion_head_{Guid.NewGuid():N}";

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public string? Badge { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool DefaultOpen { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    public bool IsOpen => this.Parent?.IsActive(this) ?? false;

    [CascadingParameter]
    private Accordion? Parent { get; set; }

    [EditorRequired, Parameter]
    public string Title { get; set; } = default!;

    public void Close() => this.Parent?.Close(this);

    public void Dispose()
    {
        if (this.Parent is not null)
        {
            this.Parent.OnStateChanged -= this.StateHasChanged;
        }
    }

    private void OnClickHeader()
    {
        if (this.Disabled)
            return;

        this.Toggle();
    }

    protected override void OnInitialized()
    {
        if (this.Parent is null)
        {
            throw new InvalidOperationException(
                $"{nameof(AccordionItem)} must be contained within an {nameof(Accordion)} component.");
        }

        this.Parent.OnStateChanged += this.StateHasChanged;

        if (this.DefaultOpen)
        {
            this.Parent.Open(this);
        }
    }

    public void Open() => this.Parent?.Open(this);

    public void Toggle() => this.Parent?.Toggle(this);
}
