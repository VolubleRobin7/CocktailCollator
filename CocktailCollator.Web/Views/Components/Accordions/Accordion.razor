<CascadingValue IsFixed="true" 
                Value="this">

    <div @attributes="this.AdditionalAttributes" 
         class="accordion">

        @this.ChildContent

    </div>

</CascadingValue>

@code {
    internal event Action? OnStateChanged;

    private AccordionItem? _activeItem;

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public bool AllowAllClosed { get; set; }

    [EditorRequired, Parameter]
    public RenderFragment ChildContent { get; set; }

    public void Close(AccordionItem item)
    {
        if (!this.AllowAllClosed || this._activeItem != item)
            return;

        this._activeItem = null;
        this.OnStateChanged?.Invoke();
    }

    public void CloseAll()
    {
        if (!this.AllowAllClosed || this._activeItem is null)
            return;

        this._activeItem = null;
        this.OnStateChanged?.Invoke();
    }

    public bool IsActive(AccordionItem item) 
        => this._activeItem == item;

    public void Open(AccordionItem item)
    {
        if (this._activeItem == item)
            return;

        this._activeItem = item;
        this.OnStateChanged?.Invoke();
    }

    public void Toggle(AccordionItem item)
    {
        if (this.IsActive(item))
        {
            if (this.AllowAllClosed)
                this.Close(item);
        }
        else
        {
            this.Open(item);
        }
    }
}
