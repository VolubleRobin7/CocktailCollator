<CascadingValue IsFixed="true" 
                Value="this">

    <div @attributes="this.AdditionalAttributes" 
         class="accordion">

        @this.ChildContent

    </div>

</CascadingValue>

@code {
    private AccordionItem? _activeItem;
    private readonly List<AccordionItem> _items = [];

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public bool AllowAllClosed { get; set; }

    [EditorRequired, Parameter]
    public RenderFragment ChildContent { get; set; }

    public void CloseAll()
    {
        if (!this.AllowAllClosed || this._activeItem is null)
            return;

        this._activeItem.Close();
    }

    public bool IsActive(AccordionItem item) 
        => this._activeItem == item;

    internal void OnItemClosed(AccordionItem item)
    {
        if (this._activeItem == item)
            this._activeItem = null;
    }

    internal void OnItemOpened(AccordionItem item)
    {
        if (this._activeItem != null && this._activeItem != item)
        {
            var previous = this._activeItem;
            this._activeItem = item;
            previous.Close();
        }
        else
        {
            this._activeItem = item;
        }
    }

    internal void Register(AccordionItem item)
    {
        if (!this._items.Contains(item))
        {
            this._items.Add(item);

            if (this._activeItem is null && !this.AllowAllClosed && !item.Disabled)
                item.Open();
        }
    }

    internal void Unregister(AccordionItem item)
    {
        this._items.Remove(item);

        if (this._activeItem == item)
            this._activeItem = null;
    }
}
